#!/usr/bin/env bash

set -euo pipefail

srctree="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
objtree="${O:-${srctree}/out/build-test}"
jobs="${JOBS:-$(nproc)}"
arm_cross_compile="${ARM_CROSS_COMPILE:-arm-none-eabi-}"
riscv_cross_compile="${RISCV_CROSS_COMPILE:-riscv64-unknown-elf-}"
firmware_cross_compile="${FIRMWARE_CROSS_COMPILE:-${riscv_cross_compile}}"
bl33_cross_compile="${BL33_CROSS_COMPILE:-${arm_cross_compile}}"
log_dir="${objtree}/logs"
total_apps=0
total_images=0
total_firmware=0
total_utilities=0

die() {
	echo "build test: $*" >&2
	exit 1
}

config_value() {
	sed -n "s/^$1=//p" "${objtree}/.config"
}

validate_board_outputs() {
	local board="$1"
	local image_dir app actual expected image size
	local fel_max_raw bin_max_raw fel_max bin_max card_max spi_max
	local -a board_apps firmware_dirs

	mapfile -t board_apps < <(
		make -C "${srctree}" --no-print-directory -s O="${objtree}" list-apps
	)
	((${#board_apps[@]} > 0)) || die "${board} has no applications"

	fel_max_raw="$(config_value CONFIG_SPL_FEL_MAX_SIZE)"
	bin_max_raw="$(config_value CONFIG_SPL_BIN_MAX_SIZE)"
	[[ -n "${fel_max_raw}" && -n "${bin_max_raw}" ]] ||
		die "${board} has no image size limits"
	fel_max=$((fel_max_raw))
	bin_max=$((bin_max_raw))
	card_max=$(((bin_max + 511) / 512 * 512))
	spi_max=$(((bin_max + 8191) / 8192 * 8192))

	for app in "${board_apps[@]}"; do
		image_dir="${objtree}/build/${board}/${app}"
		[[ -d "${image_dir}" ]] || die "missing image directory ${image_dir}"

		expected="$(printf '%s\n' \
			"${app}_card.bin" "${app}_fel.bin" "${app}_spi.bin" | sort)"
		actual="$(find "${image_dir}" -maxdepth 1 -type f -name '*.bin' \
			-printf '%f\n' | sort)"
		[[ "${actual}" == "${expected}" ]] ||
			die "${board}/${app} does not contain exactly its three images"

		for image in "${app}_card.bin" "${app}_fel.bin" "${app}_spi.bin"; do
			[[ -s "${image_dir}/${image}" ]] ||
				die "empty image ${image_dir}/${image}"
		done

		size="$(stat -c %s "${image_dir}/${app}_fel.bin")"
		((size <= fel_max)) ||
			die "${board}/${app} FEL image exceeds CONFIG_SPL_FEL_MAX_SIZE"

		size="$(stat -c %s "${image_dir}/${app}_card.bin")"
		((size <= card_max && size % 512 == 0)) ||
			die "${board}/${app} card image exceeds its limit or is not sector aligned"

		size="$(stat -c %s "${image_dir}/${app}_spi.bin")"
		((size <= spi_max && size % 8192 == 0)) ||
			die "${board}/${app} SPI image exceeds its limit or is not 8 KiB aligned"
	done

	total_apps=$((total_apps + ${#board_apps[@]}))
	total_images=$((total_images + ${#board_apps[@]} * 3))

	mapfile -t firmware_dirs < <(
		make -C "${srctree}" --no-print-directory -s O="${objtree}" list-firmware
	)
	for image_dir in "${firmware_dirs[@]}"; do
		image_dir="${objtree}/firmware/${board}/${image_dir}"
		[[ -d "${image_dir}" ]] || die "missing firmware directory ${image_dir}"
		find "${image_dir}" -type f -name '*.bin' -size +0c -print -quit |
			grep -q . || die "${image_dir} contains no firmware image"
		total_firmware=$((total_firmware + 1))
	done
}

test_kconfig_lifecycle() {
	local config_obj="${objtree}/config-lifecycle"
	local lifecycle_log="${log_dir}/config-lifecycle.log"
	local mixed_goals_log="${log_dir}/mixed-goals.log"

	make -C "${srctree}" O="${config_obj}" mrproper
	make -C "${srctree}" O="${config_obj}" tinyvision_defconfig
	sed -i '/^# CONFIG_BUILD_TRACE is not set$/d' "${config_obj}/.config"
	make -C "${srctree}" O="${config_obj}" olddefconfig </dev/null 2>&1 |
		tee "${lifecycle_log}"
	if grep -q -E 'Error in reading or end of file|Restart config' "${lifecycle_log}"; then
		die "olddefconfig prompted for a new symbol"
	fi
	grep -Fqx '# CONFIG_BUILD_TRACE is not set' "${config_obj}/.config" ||
		die "olddefconfig did not restore the default value"

	make -C "${srctree}" O="${config_obj}" savedefconfig
	diff -u \
		<(sed -n '/^CONFIG_/p' "${srctree}/configs/tinyvision_defconfig" | sort) \
		<(sed -n '/^CONFIG_/p' "${config_obj}/defconfig" | sort)
	make -C "${srctree}" O="${config_obj}" syncconfig
	if make -C "${srctree}" O="${config_obj}" \
			CROSS_COMPILE="${arm_cross_compile}" \
			DT2C="${config_obj}/missing-dt2c" prepare tools \
			>"${mixed_goals_log}" 2>&1; then
		die "prepare tools skipped dt2c with a configured board"
	fi
	grep -Fq 'dt2c was not found; set DT2C=/path/to/dt2c' \
		"${mixed_goals_log}" || {
		cat "${mixed_goals_log}" >&2
		die "prepare tools did not reach the dt2c availability check"
	}
	make -C "${srctree}" O="${config_obj}" \
		CROSS_COMPILE="${arm_cross_compile}" prepare tools

	make -C "${srctree}" O="${config_obj}" clean
	[[ -f "${config_obj}/.config" ]] || die "clean removed .config"
	[[ ! -e "${config_obj}/include/generated/config.h" ]] ||
		die "clean left generated project configuration"
	[[ ! -e "${config_obj}/tools/mksunxi" ]] || die "clean left host tools"

	make -C "${srctree}" O="${config_obj}" mrproper
	for image in .config .kconfig defconfig include/config include/generated; do
		[[ ! -e "${config_obj}/${image}" ]] ||
			die "mrproper left ${config_obj}/${image}"
	done
}

test_utilities() {
	local utility image
	local utility_log="${log_dir}/utilities.log"
	local -a utility_dirs

	make -C "${srctree}" O="${objtree}" utilities \
		BL33_CROSS_COMPILE="${bl33_cross_compile}" 2>&1 | tee "${utility_log}"
	grep -q 'warning:' "${utility_log}" &&
		die "build warnings found in ${utility_log}"

	mapfile -t utility_dirs < <(
		make -C "${srctree}" --no-print-directory -s list-utilities
	)
	for utility in "${utility_dirs[@]}"; do
		image="${objtree}/utilities/${utility}/syter_bl33.bin"
		[[ -s "${image}" ]] || die "missing utility image ${image}"
		total_utilities=$((total_utilities + 1))
	done
}

compile_mmc_host() {
	local name="$1"
	local board_defconfig="$2"
	local cross_compile="$3"
	local driver_object="$4"
	local coverage_obj="${objtree}/driver-coverage/${name}"
	local coverage_log="${log_dir}/mmc-${name}.log"

	make -C "${srctree}" O="${coverage_obj}" mrproper
	make -C "${srctree}" O="${coverage_obj}" "${board_defconfig}"
	sed -i -E \
		-e '/^CONFIG_DRIVER_MMC=y$/d' \
		-e '/^# CONFIG_DRIVER_MMC is not set$/d' \
		"${coverage_obj}/.config"
	printf 'CONFIG_DRIVER_MMC=y\n' >> "${coverage_obj}/.config"
	make -C "${srctree}" O="${coverage_obj}" olddefconfig
	grep -Fqx 'CONFIG_DRIVER_MMC=y' "${coverage_obj}/.config" ||
		die "${name} MMC host coverage configuration was not enabled"

	make -C "${srctree}" O="${coverage_obj}" \
		CROSS_COMPILE="${cross_compile}" \
		"${coverage_obj}/.obj/drivers/mmc/host/built-in.o" 2>&1 |
		tee "${coverage_log}"
	grep -q 'warning:' "${coverage_log}" &&
		die "build warnings found in ${coverage_log}"
	[[ -f "${coverage_obj}/.obj/drivers/mmc/host/${driver_object}.o" ]] ||
		die "${driver_object}.c was not compiled"
}

mkdir -p "${log_dir}"
make -C "${srctree}" check
make -C "${srctree}" O="${objtree}" clean
test_kconfig_lifecycle
test_utilities

for defconfig in "${srctree}"/configs/*_defconfig; do
	name="${defconfig##*/}"
	log="${log_dir}/${name%_defconfig}.log"
	: > "${log}"

	make -C "${srctree}" O="${objtree}" "${name}" 2>&1 | tee -a "${log}"

	if grep -q '^CONFIG_ARCH_RISCV' "${objtree}/.config"; then
		cross_compile="${riscv_cross_compile}"
	else
		cross_compile="${arm_cross_compile}"
	fi

	make -C "${srctree}" O="${objtree}" \
		CROSS_COMPILE="${cross_compile}" -j"${jobs}" 2>&1 | tee -a "${log}"
	make -C "${srctree}" O="${objtree}" firmware \
		CROSS_COMPILE="${cross_compile}" \
		FIRMWARE_CROSS_COMPILE="${firmware_cross_compile}" \
		-j"${jobs}" 2>&1 | tee -a "${log}"

	if grep -q 'warning:' "${log}"; then
		die "build warnings found in ${log}"
	fi

	board="$(config_value CONFIG_SYS_BOARD)"
	board="${board%\"}"
	board="${board#\"}"
	validate_board_outputs "${board}"
done

actual_images="$(find "${objtree}/build" -mindepth 3 -maxdepth 3 \
	-type f -name '*.bin' | wc -l)"
[[ "${actual_images}" -eq "${total_images}" ]] ||
	die "found ${actual_images} main images, expected ${total_images}"

compile_mmc_host sun20iw1 100ask-d1-h_defconfig \
	"${riscv_cross_compile}" mmc-sun20iw1
compile_mmc_host sun50iw9 longanpi-3h_defconfig \
	"${arm_cross_compile}" mmc-sun50iw9
compile_mmc_host sun8iw21 tinyvision_defconfig \
	"${arm_cross_compile}" mmc-sun8iw21

printf 'Build test passed: %d applications, %d main images, %d companion firmware images, %d utility images.\n' \
	"${total_apps}" "${total_images}" "${total_firmware}" "${total_utilities}"

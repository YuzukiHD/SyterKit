mainmenu "SyterKit Configuration"

source "arch/Kconfig"
source "drivers/Kconfig"
source "core/Kconfig"
source "lib/Kconfig"

choice
	prompt "Application runtime mode"
	default APP_SRAM

config APP_SRAM
	bool "SRAM application"

config EFEX
	bool "Returning eFEX application"
	depends on !ARCH_RISCV64

config APP_DRAM
	bool "DRAM application"

endchoice

source "boards/Kconfig"
source "soc/Kconfig"

menu "Image layout"

config SPL_BIN_TEXT_BASE
	hex "Binary image load address"
	depends on APP_SRAM

config SPL_BIN_MAX_SIZE
	hex "Binary image maximum size"
	depends on APP_SRAM

config SPL_FEL_TEXT_BASE
	hex "FEL image load address"

config SPL_FEL_MAX_SIZE
	hex "FEL image maximum size"

config APP_DRAM_TEXT_BASE
	hex "DRAM application load address"
	depends on APP_DRAM
	default 0x82000000 if BOARD_AVAOTA_F1
	default 0x42000000

config APP_DRAM_MAX_SIZE
	hex "DRAM application maximum size"
	depends on APP_DRAM
	default 0x01000000

endmenu

menu "Build options"

choice
	prompt "Build mode"
	optional

config BUILD_RELEASE
	bool "Release"

config BUILD_DEBUG
	bool "Debug"

config BUILD_TRACE
	bool "Trace"

endchoice

config OPTIMIZE_FOR_SIZE
	bool "Optimize for size"

config RUST_FFI
	bool "Build Rust FFI and applications"
	depends on DRIVER_SERIAL
	help
	  Build the no_std Rust FFI, driver, core, and library crates. Bindings are generated
	  by bindgen from rust/ffi/headers.txt; board-declared Rust applications are
	  linked into the selected image. The feature is optional so normal C-only
	  builds do not require Rust or libclang.

endmenu

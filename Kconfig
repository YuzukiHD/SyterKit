mainmenu "SyterKit Configuration"

source "arch/Kconfig"
source "drivers/Kconfig"
source "core/Kconfig"
source "lib/Kconfig"
source "boards/Kconfig"

menu "Build options"

choice
	prompt "Build mode"
	optional

config BUILD_RELEASE
	bool "Release"

config BUILD_DEBUG
	bool "Debug"

config BUILD_TRACE
	bool "Trace"

endchoice

config OPTIMIZE_FOR_SIZE
	bool "Optimize for size"

config RUST_FFI
	bool "Build Rust FFI and applications"
	depends on DRIVER_SERIAL
	help
	  Build the no_std Rust FFI, driver, core, and library crates. Bindings are generated
	  by bindgen from rust/ffi/headers.txt; board-declared Rust applications are
	  linked into the selected image. The feature is optional so normal C-only
	  builds do not require Rust or libclang.

endmenu

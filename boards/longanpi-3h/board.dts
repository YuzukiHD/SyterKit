/dts-v1/;

#include <dt-bindings/gpio/sunxi-gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "LonganPi 3H";
	compatible = "syterkit,longanpi-3h";

	aliases {
		ccu0 = &ccu0;
		sid0 = &sid0;
		dma0 = &dma0;
		dram0 = &dram0;
		i2c0 = &i2c0;
		mmc0 = &mmc0;
		pmu0 = &pmu0;
		rtc0 = &rtc0;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = &uart0;
	};

	ccu0: clock-controller@3001000 {
		compatible = "allwinner,sun50iw9-ccu";
		reg = <0x03001000 0x1000>,
		      <0x07010000 0x1000>,
		      <0x030f0000 0x1000>;
		reg-names = "ccu", "r-prcm", "iommu";
		status = "okay";
	};

	dram0: dram-controller {
		compatible = "allwinner,sun50iw9-dram";
		allwinner,dram-parameters =
			<0x2d0 0x8 0x0c0c0c0c 0x0e0e0e0e>,
			<0x0a0e 0x7887ffff 0x30fa 0x04000000>,
			<0x0 0x34 0x1b 0x33 0x3 0x0 0x0 0x4>,
			<0x72 0x0 0x9 0x0 0x0 0x24 0x0 0x0>,
			<0x0 0x0 0x39808080 0x402f6603>,
			<0x20262620 0x0e0e0f0f 0x1024 0x0>;
		allwinner,rtc = <&rtc0>;
		memory-region = <&dram_init_code>;
		status = "okay";
	};

	pio: pinctrl@300b000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <0x0300b000 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		gpio-controller;
		#gpio-cells = <3>;

		mmc0_pins: mmc0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_F 2 2>,
				<SUNXI_GPIO_PORT_F 3 2>,
				<SUNXI_GPIO_PORT_F 1 2>,
				<SUNXI_GPIO_PORT_F 0 2>,
				<SUNXI_GPIO_PORT_F 5 2>,
				<SUNXI_GPIO_PORT_F 4 2>;
		};

		spi0_pins: spi0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 1 4>,
				<SUNXI_GPIO_PORT_C 0 4>,
				<SUNXI_GPIO_PORT_C 2 4>,
				<SUNXI_GPIO_PORT_C 3 4>,
				<SUNXI_GPIO_PORT_C 4 4>,
				<SUNXI_GPIO_PORT_C 5 4>;
		};

		uart0_pins: uart0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_H 0 2>,
				<SUNXI_GPIO_PORT_H 1 2>;
		};
	};

	r_pio: pinctrl@7022000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <0x07022000 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_L>;
		allwinner,bank-count = <3>;
		gpio-controller;
		#gpio-cells = <3>;

		i2c0_pins: i2c0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_L 0 3>,
				<SUNXI_GPIO_PORT_L 1 3>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mmc0_dma: dma-descriptors@50080000 {
			reg = <0x50080000 0x100000>;
			no-map;
		};

		dram_init_code: dram-init-code@48000 {
			reg = <0x00048000 0x00008000>;
			no-map;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sid0: efuse@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <0x03006000 0x400>;
			allwinner,efuse-hv-switch = <0x07000204>;
			status = "okay";
		};

		rtc0: rtc@7000100 {
			compatible = "allwinner,sunxi-rtc";
			reg = <0x07000100 0x100>;
			status = "okay";
		};

		mmc0: mmc@4020000 {
			compatible = "allwinner,sunxi-mmc";
			reg = <0x04020000 0x1000>;
			label = "SD Card";
			allwinner,mmc-id = <0>;
			bus-width = <4>;
			max-frequency = <50000000>;
			memory-region = <&mmc0_dma>;
			allwinner,clock-gate = <0x0300184c 0>;
			allwinner,reset = <0x0300184c 16>;
			allwinner,module-clock =
				<0x03001830 8 0 1>;
			allwinner,clock-source-rates =
				<24000000 300000000 600000000 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc0_pins>;
			status = "okay";
		};

		dma0: dma-controller@3002000 {
			compatible = "allwinner,sunxi-dma";
			reg = <0x03002000 0x1000>;
			#dma-cells = <1>;
			allwinner,mbus-clock-gate = <0x03001804 0>;
			allwinner,clock-gate = <0x0300170c 0>;
			allwinner,reset = <0x0300170c 16>;
			status = "okay";
		};

		spi0: spi@5010000 {
			compatible = "allwinner,sunxi-spi";
			allwinner,spi-id = <0>;
			reg = <0x05010000 0x1000>;
			clock-frequency = <75000000>;
			allwinner,module-clock = <0x03001940 1 8 300000000 0>;
			allwinner,clock-gate = <0x0300196c 0>;
			allwinner,reset = <0x0300196c 16>;
			dmas = <&dma0 22>;
			dma-names = "rx";
			pinctrl-names = "default";
			pinctrl-0 = <&spi0_pins>;
			status = "okay";
		};

		i2c0: i2c@7081400 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x07081400 0x400>;
			clock-frequency = <400000>;
			allwinner,i2c-id = <6>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <0x0701019c 0>;
			allwinner,reset = <0x0701019c 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_pins>;
			status = "okay";

			pmu0: pmic@36 {
				compatible = "x-powers,axp1530";
				reg = <0x36>;
				status = "okay";
			};
		};

		uart0: serial@5000000 {
			compatible = "allwinner,sunxi-uart";
			reg = <0x05000000 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <0>;
			allwinner,clock-gate = <0x0300190c 0>;
			allwinner,reset = <0x0300190c 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_pins>;
			status = "okay";
		};
	};
};

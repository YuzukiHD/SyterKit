/dts-v1/;

#include <dt-bindings/gpio/sunxi-gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Avaota M1";
	compatible = "syterkit,avaota-m1";

	aliases {
		i2c0 = &i2c0;
		pmu0 = &pmu0;
		pmu1 = &pmu1;
	};

	chosen {
		stdout-path = &uart0;
	};

	pinctrl {
		i2c0_pins: i2c0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_L 0 2>,
				<SUNXI_GPIO_PORT_L 1 2>;
		};

		uart0_pins: uart0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_B 10 2>,
				<SUNXI_GPIO_PORT_B 11 2>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		i2c0: i2c@7108000 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x07108000 0x400>;
			clock-frequency = <400000>;
			allwinner,i2c-id = <6>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <0x0703019c 0>;
			allwinner,reset = <0x0703019c 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_pins>;
			status = "okay";

			pmu0: pmic@34 {
				compatible = "x-powers,axp2202";
				reg = <0x34>, <0x35>;
				status = "okay";
			};

			pmu1: pmic@36 {
				compatible = "x-powers,axp1530";
				reg = <0x36>;
				status = "okay";
			};
		};

		uart0: serial@2b00000 {
			compatible = "allwinner,sunxi-uart";
			reg = <0x02b00000 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <0>;
			allwinner,clock-gate = <0x03008e00 0>;
			allwinner,reset = <0x03008e00 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_pins>;
			status = "okay";
		};
	};
};

// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;

#include <dt-bindings/gpio/sunxi-gpio.h>
#include <dt-bindings/soc/sun252iw2.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Yuzuki Neko";
	compatible = "syterkit,yuzukineko";

	aliases {
		sid0 = &sid0;
		psram0 = &psram0;
		intc0 = &clic0;
		uart1 = &uart1;
		dma0 = &dma0;
		spi0 = &spi0;
		spi-nor0 = &spi_nor0;
	};

	chosen {
		stdout-path = &uart1;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <SUNXI_PSRAM_BASE 0x01000000>;
	};

	psram0: psram-controller {
		compatible = "allwinner,sunxi-psram";
		allwinner,psram-parameters = <252>;
		status = "okay";
	};

	pio: pinctrl@2000000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <SUNXI_GPIO_BASE 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		gpio-controller;
		#gpio-cells = <3>;

		uart1_pins: uart1-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_B 0 4>,
				<SUNXI_GPIO_PORT_B 1 4>;
		};

		spi0_pins: spi0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 1 3>,
				<SUNXI_GPIO_PORT_C 0 3>,
				<SUNXI_GPIO_PORT_C 4 3>,
				<SUNXI_GPIO_PORT_C 2 3>,
				<SUNXI_GPIO_PORT_C 3 3>,
				<SUNXI_GPIO_PORT_C 5 3>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sid0: efuse@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <SUNXI_SID_BASE 0x400>;
			allwinner,efuse-hv-switch = <(SUNXI_RTC_BASE + 0x204)>;
			status = "okay";
		};

		clic0: interrupt-controller@14000000 {
			compatible = "thead,c900-clic";
			reg = <SUNXI_RISCV_CLIC_BASE 0x2000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-sources = <208>;
			status = "okay";
		};

		uart1: serial@2500400 {
			compatible = "allwinner,sunxi-uart";
			reg = <SUNXI_UART1_BASE 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <1>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x90c) 1>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x90c) 17>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart1_pins>;
			status = "okay";
		};

		dma0: dma-controller@3002000 {
			compatible = "allwinner,sunxi-dma";
			reg = <SUNXI_DMA_BASE 0x1000>;
			#dma-cells = <1>;
			allwinner,mbus-clock-gate = <(SUNXI_CCU_BASE + 0x804) 0>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x70c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x70c) 16>;
			status = "okay";
		};

		spi0: spi@4025000 {
			compatible = "allwinner,sunxi-spi";
			#address-cells = <1>;
			#size-cells = <0>;
			allwinner,spi-id = <0>;
			reg = <SUNXI_SPI0_BASE 0x1000>;
			clock-frequency = <100000000>;
			allwinner,module-clock = <(SUNXI_CCU_BASE + 0x940) 1 8 600000000 0>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x96c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x96c) 16>;
			dmas = <&dma0 22>;
			dma-names = "rx";
			pinctrl-names = "default";
			pinctrl-0 = <&spi0_pins>;
			status = "okay";

			spi_nor0: flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <100000000>;
			};
		};
	};
};

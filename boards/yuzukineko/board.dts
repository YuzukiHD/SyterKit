// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;

#include <dt-bindings/gpio/sunxi-gpio.h>
#include <dt-bindings/soc/sun252iw2.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Yuzuki Neko";
	compatible = "syterkit,yuzukineko";

	aliases {
		sid0 = &sid0;
		psram0 = &psram0;
		intc0 = &clic0;
		uart1 = &uart1;
		spif0 = &spif0;
		spif-nor0 = &spif_nor0;
	};

	chosen {
		stdout-path = &uart1;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <SUNXI_PSRAM_BASE 0x01000000>;
	};

	psram0: psram-controller {
		compatible = "allwinner,sunxi-psram";
		allwinner,psram-parameters = <252>;
		status = "okay";
	};

	pio: pinctrl@2000000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <SUNXI_GPIO_BASE 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		gpio-controller;
		#gpio-cells = <3>;

		uart1_pins: uart1-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_B 0 4>,
				<SUNXI_GPIO_PORT_B 1 4>;
		};

		spif_pins: spif-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 1 4>,
				<SUNXI_GPIO_PORT_C 0 4>,
				<SUNXI_GPIO_PORT_C 4 4>,
				<SUNXI_GPIO_PORT_C 2 4>,
				<SUNXI_GPIO_PORT_C 3 4>,
				<SUNXI_GPIO_PORT_C 5 4>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sid0: efuse@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <SUNXI_SID_BASE 0x400>;
			allwinner,efuse-hv-switch = <(SUNXI_RTC_BASE + 0x204)>;
			status = "okay";
		};

		clic0: interrupt-controller@14000000 {
			compatible = "thead,c900-clic";
			reg = <SUNXI_RISCV_CLIC_BASE 0x2000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-sources = <208>;
			status = "okay";
		};

		uart1: serial@2500400 {
			compatible = "allwinner,sunxi-uart";
			reg = <SUNXI_UART1_BASE 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <1>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x90c) 1>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x90c) 17>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart1_pins>;
			status = "okay";
		};

		spif0: spif@c000000 {
			compatible = "allwinner,sunxi-spif";
			#address-cells = <1>;
			#size-cells = <0>;
			allwinner,spif-id = <0>;
			reg = <SUNXI_SPI_FLASH0_BASE 0x1000>;
			clock-frequency = <100000000>;
			allwinner,module-clock = <(SUNXI_CCU_BASE + 0x980) 1 8 600000000 0>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x984) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x984) 16>;
			spif-rx-bus-width = <4>;
			spif-tx-bus-width = <4>;
			dtr-enable = <1>;
			io-mode-enable = <1>;
			pinctrl-names = "default";
			pinctrl-0 = <&spif_pins>;
			status = "okay";

			spif_nor0: flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <100000000>;
			};
		};
	};
};

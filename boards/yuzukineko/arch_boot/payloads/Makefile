# Standalone build of the RV32 bootstrap payload (arch_boot.S).
#
# This directory is deliberately independent of the SyterKit Kbuild tree: the
# payload runs on the core BEFORE it is switched to RV64, so it must be
# compiled with the RV32 toolchain.  The output arch_boot_payload.inc is
# committed to the tree and #included by boards/yuzukineko/head.c; it is NOT
# regenerated by the main build.
#
# To rebuild after editing arch_boot.S:
#	make -C boards/yuzukineko/arch_boot/payloads
#
# A toolchain that understands the Xuantie C907 (-mcpu=c907fdv-rv32) is located
# by probing, in order: an explicit CROSS=, the main build's CROSS_COMPILE
# environment variable, known Xuantie install locations, then whatever
# riscv64-unknown-elf- is on PATH.  The first candidate that compiles wins.

# Probe for a working toolchain (empty on total failure => CROSS falls back).
candidate_cross := $(if $(CROSS_COMPILE),$(CROSS_COMPILE),) \
	/tmp/xuantie-v3.2.0/bin/riscv64-unknown-elf- \
	riscv64-unknown-elf-

CROSS ?= $(shell \
	for c in $(candidate_cross); do \
		if printf 'int f(void){return 0;}\n' | "$$c"gcc \
			-mcpu=c907fdv-rv32 -mabi=ilp32 -x c -c - -o /dev/null 2>/dev/null; then \
			echo "$$c"; exit 0; \
		fi; \
	done; \
	echo riscv64-unknown-elf-)

FLAGS  = -mcpu=c907fdv-rv32 -mabi=ilp32

all: arch_boot_payload.inc

arch_boot.o: arch_boot.S
	$(CROSS)gcc $(FLAGS) -c $< -o $@

arch_boot.elf: arch_boot.o arch_boot.lds
	$(CROSS)ld -m elf32lriscv -T arch_boot.lds $< -o $@

arch_boot_payload.bin: arch_boot.elf
	$(CROSS)objcopy -O binary -j .text $< $@

arch_boot_payload.inc: arch_boot_payload.bin
	python3 gen_payload.py $< $@

clean:
	rm -f arch_boot.o arch_boot.elf arch_boot_payload.bin arch_boot_payload.inc

// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;

#include <dt-bindings/display/sunxi-display.h>
#include <dt-bindings/dram/dram-param.h>

#include <dt-bindings/gpio/sunxi-gpio.h>
#include <dt-bindings/soc/sun252iw1.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Avaota F2";
	compatible = "syterkit,avaota-f2";

	aliases {
		sid0 = &sid0;
		display0 = &display0;
		display1 = &display_srgb;
		display2 = &display_i8080;
		dram0 = &dram0;
		i2c2 = &i2c2;
		intc0 = &clic0;
		mmc0 = &mmc0;
		spif0 = &spif0;
		spif-nor0 = &spif_nor0;
	};

	chosen {
		stdout-path = &uart0;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mmc0_dma: dma-descriptors@43600000 {
			reg = <0x43600000 0x00100000>;
			no-map;
		};
	};

	dram0: dram-controller {
		compatible = "allwinner,sunxi-dram";
		allwinner,dram-base = <0x40000000>;
		allwinner,dram-parameters =
			<1056>,
			<SUNXI_DRAM_DDR3>,
			<0x007b6bfb>,
			<0x00000001>,
			<0x000010d2>,
			<0x00000000>,
			<0x00001c70>,
			<0x00000002>,
			<0x00000018>,
			<0x00000000>,
			<0x004a2195>,
			<0x02423190>,
			<0x0008b061>,
			<0xb4787896>,
			<0x00000000>,
			<0x48484848>,
			<0x00000048>,
			<0x1621121e>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>, // 0x001d0000 for training
			<0x00460000>,
			<0x00000055>,
			<0x34040500>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>;
		status = "okay";
	};

	pio: pinctrl@2000000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <SUNXI_GPIO_BASE 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		gpio-controller;
		#gpio-cells = <3>;

		uart0_pins: uart0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_H 9 5>,
				<SUNXI_GPIO_PORT_H 10 5>;
		};

		spif_pins: spif-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 1 2>,
				<SUNXI_GPIO_PORT_C 0 2>,
				<SUNXI_GPIO_PORT_C 2 2>,
				<SUNXI_GPIO_PORT_C 3 2>,
				<SUNXI_GPIO_PORT_C 4 2>,
				<SUNXI_GPIO_PORT_C 5 2>;
		};

		mmc0_pins: mmc0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_F 2 2>,
				<SUNXI_GPIO_PORT_F 3 2>,
				<SUNXI_GPIO_PORT_F 1 2>,
				<SUNXI_GPIO_PORT_F 0 2>,
				<SUNXI_GPIO_PORT_F 5 2>,
				<SUNXI_GPIO_PORT_F 4 2>;
		};

		/* parallel RGB888: D0..D23 are PD0-PD17 and PE0-PE5 (low bits), PD18 pixel clock, PD19..PD21 DE/HS/VS. Pins from the vendor BSP, the signal order is not checked on the board */
		lcd_rgb24_pins: lcd-rgb24-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_D 0 2>,
				<SUNXI_GPIO_PORT_D 1 2>,
				<SUNXI_GPIO_PORT_D 2 2>,
				<SUNXI_GPIO_PORT_D 3 2>,
				<SUNXI_GPIO_PORT_D 4 2>,
				<SUNXI_GPIO_PORT_D 5 2>,
				<SUNXI_GPIO_PORT_D 6 2>,
				<SUNXI_GPIO_PORT_D 7 2>,
				<SUNXI_GPIO_PORT_D 8 2>,
				<SUNXI_GPIO_PORT_D 9 2>,
				<SUNXI_GPIO_PORT_D 10 2>,
				<SUNXI_GPIO_PORT_D 11 2>,
				<SUNXI_GPIO_PORT_D 12 2>,
				<SUNXI_GPIO_PORT_D 13 2>,
				<SUNXI_GPIO_PORT_D 14 2>,
				<SUNXI_GPIO_PORT_D 15 2>,
				<SUNXI_GPIO_PORT_D 16 2>,
				<SUNXI_GPIO_PORT_D 17 2>,
				<SUNXI_GPIO_PORT_D 18 2>,
				<SUNXI_GPIO_PORT_D 19 2>,
				<SUNXI_GPIO_PORT_D 20 2>,
				<SUNXI_GPIO_PORT_D 21 2>,
				<SUNXI_GPIO_PORT_E 0 4>,
				<SUNXI_GPIO_PORT_E 1 4>,
				<SUNXI_GPIO_PORT_E 2 4>,
				<SUNXI_GPIO_PORT_E 3 4>,
				<SUNXI_GPIO_PORT_E 4 4>,
				<SUNXI_GPIO_PORT_E 5 4>;
		};

		/* serial RGB: 8 data pins PD1-PD8, PD18 clock, PD19..PD21 DE/HS/VS (vendor BSP rgb8 group), not checked on the board */
		lcd_rgb8_pins: lcd-rgb8-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_D 1 2>,
				<SUNXI_GPIO_PORT_D 2 2>,
				<SUNXI_GPIO_PORT_D 3 2>,
				<SUNXI_GPIO_PORT_D 4 2>,
				<SUNXI_GPIO_PORT_D 5 2>,
				<SUNXI_GPIO_PORT_D 6 2>,
				<SUNXI_GPIO_PORT_D 7 2>,
				<SUNXI_GPIO_PORT_D 8 2>,
				<SUNXI_GPIO_PORT_D 18 2>,
				<SUNXI_GPIO_PORT_D 19 2>,
				<SUNXI_GPIO_PORT_D 20 2>,
				<SUNXI_GPIO_PORT_D 21 2>;
		};

		/* i8080, 8 bit data (the vendor cpu_16bit_65k group): PD1-PD8 data, PD18 write strobe, PD19..PD21 control; not checked on the board */
		lcd_i8080_pins: lcd-i8080-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_D 1 2>,
				<SUNXI_GPIO_PORT_D 2 2>,
				<SUNXI_GPIO_PORT_D 3 2>,
				<SUNXI_GPIO_PORT_D 4 2>,
				<SUNXI_GPIO_PORT_D 5 2>,
				<SUNXI_GPIO_PORT_D 6 2>,
				<SUNXI_GPIO_PORT_D 7 2>,
				<SUNXI_GPIO_PORT_D 8 2>,
				<SUNXI_GPIO_PORT_D 18 2>,
				<SUNXI_GPIO_PORT_D 19 2>,
				<SUNXI_GPIO_PORT_D 20 2>,
				<SUNXI_GPIO_PORT_D 21 2>;
		};
	};

	r_pio: pinctrl@2000540 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <SUNXI_RGPIO_BASE 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_L>;
		allwinner,bank-count = <3>;
		gpio-controller;
		#gpio-cells = <3>;

		i2c2_pins: i2c2-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_L 3 2>,
				<SUNXI_GPIO_PORT_L 4 2>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sid0: efuse@7091000 {
			compatible = "allwinner,sunxi-sid";
			reg = <SUNXI_SID_BASE 0x400>;
			status = "okay";
		};

		clic0: interrupt-controller@30800000 {
			compatible = "thead,c900-clic";
			reg = <SUNXI_RISCV_CLIC_BASE 0x2000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-sources = <208>;
			status = "okay";
		};

		mmc0: mmc@4020000 {
			compatible = "allwinner,sunxi-mmc";
			reg = <SUNXI_SMHC0_BASE 0x1000>;
			label = "sdhci0";
			allwinner,mmc-id = <0>;
			bus-width = <4>;
			max-frequency = <50000000>;
			memory-region = <&mmc0_dma>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x84c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x84c) 16>;
			allwinner,module-clock = <(SUNXI_CCU_BASE + 0x830) 8 0 1>;
			allwinner,clock-source-rates = <24000000 400000000 300000000 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc0_pins>;
			status = "okay";
		};

		i2c2: i2c@2502000 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <SUNXI_TWI2_BASE 0x400>;
			clock-frequency = <400000>;
			allwinner,i2c-id = <2>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x91c) 2>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x91c) 18>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c2_pins>;
			status = "okay";
		};

		uart0: serial@2500000 {
			compatible = "allwinner,sunxi-uart";
			reg = <SUNXI_UART0_BASE 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <0>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x90c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x90c) 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_pins>;
			status = "okay";
		};

		spif0: spif@c000000 {
			compatible = "allwinner,sunxi-spif";
			#address-cells = <1>;
			#size-cells = <0>;
			allwinner,spif-id = <0>;
			reg = <SUNXI_SPI_FLASH_BASE 0x1000>;
			clock-frequency = <80000000>;
			allwinner,module-clock = <(SUNXI_CCU_BASE + 0x950) 1 8 400000000 0>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x96c) 4>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x96c) 20>;
			spif-rx-bus-width = <4>;
			spif-tx-bus-width = <4>;
			dtr-enable = <1>;
			io-mode-enable = <1>;
			pinctrl-names = "default";
			pinctrl-0 = <&spif_pins>;
			status = "okay";

			spif_nor0: flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <80000000>;
			};
		};

		/*
		 * Display: de0 -> tcon_lcd0 -> one of three outputs, each with a panel preset:
		 *   display0  parallel RGB888, 800x480 (the timing of the vendor BSP boards)
		 *   display1  serial RGB, the ILI8961 320x240 panel of the vendor board
		 *   display2  i8080, the ILITEK ILI3031B 240x240 panel of the vendor board
		 * The board has no panel, so none of these is checked on real hardware. The outputs share the TCON,
		 * use one at a time. The TCON pixel clock comes from PLL_PERI(2X) (mux 1): PLL_VIDEO starts at
		 * 1272 MHz, too fast for a slow pixel clock.
		 */
		de0: display-engine@5000000 {
			compatible = "allwinner,sunxi-de";
			reg = <SUNXI_DE_BASE 0x200000>;
			allwinner,variant = "sun252iw1";
			allwinner,module-clock = <(SUNXI_CCU_BASE + 0x600) 0>;
			clock-frequency = <300000000>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x60c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x60c) 16>;
			status = "okay";
		};

		tcon_top0: tcon-top@5460000 {
			compatible = "allwinner,sunxi-tcon-top";
			reg = <SUNXI_TCON_TOP_BASE 0x1000>;
			allwinner,variant = "sun252iw1";
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0xabc) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0xabc) 16>;
			status = "okay";
		};

		tcon_lcd0: tcon-lcd@5461000 {
			compatible = "allwinner,sunxi-tcon-lcd";
			reg = <SUNXI_TCON_LCD0_BASE 0x1000>;
			allwinner,variant = "sun252iw1";
			allwinner,tcon-id = <0>;
			allwinner,module-clock = <(SUNXI_CCU_BASE + 0xb60) 1>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0xb7c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0xb7c) 16>;
			status = "okay";
		};

		rgb0: rgb-output {
			compatible = "allwinner,sunxi-rgb";
			allwinner,hv-mode = <0>;
			allwinner,drive-level = <1>;
			pinctrl-names = "default";
			pinctrl-0 = <&lcd_rgb24_pins>;
			status = "okay";
		};

		rgb_serial0: rgb-serial-output {
			compatible = "allwinner,sunxi-rgb";
			allwinner,hv-mode = <8>;
			allwinner,srgb-seq = <6>; /* BRG then GBR, as the vendor board */
			allwinner,drive-level = <1>;
			pinctrl-names = "default";
			pinctrl-0 = <&lcd_rgb8_pins>;
			status = "okay";
		};

		/* ILI3031B as in the vendor board: 8 bit bus, 65K colours (mode 14), frames by trigger with the TE pad */
		i8080_0: i8080-output {
			compatible = "allwinner,sunxi-i8080";
			allwinner,cpu-mode = <14>;
			allwinner,cpu-trigger;
			allwinner,cpu-te = <2>;
			allwinner,drive-level = <1>;
			pinctrl-names = "default";
			pinctrl-0 = <&lcd_i8080_pins>;
			status = "okay";
		};

		panel_rgb: panel-rgb {
			compatible = "allwinner,sunxi-panel";
			allwinner,gpio-controller = <&pio>;
			clock-frequency = <33000000>;
			hactive = <800>;
			vactive = <480>;
			hsync-len = <10>;
			hfront-porch = <25>;
			hback-porch = <46>;
			vsync-len = <10>;
			vfront-porch = <22>;
			vback-porch = <20>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
			allwinner,bus-format = "rgb888";
			status = "okay";
		};

		/* ILI8961, 320x240 serial RGB (vendor default/linux-6.6-xuantie/lcd/ili8961.dtsi): the porches are in dclk cycles */
		panel_srgb: panel-srgb {
			compatible = "allwinner,sunxi-panel";
			allwinner,gpio-controller = <&pio>;
			clock-frequency = <27000000>;
			hactive = <320>;
			vactive = <240>;
			hsync-len = <1>;
			hfront-porch = <1325>;
			hback-porch = <70>;
			vsync-len = <1>;
			vfront-porch = <1>;
			vback-porch = <21>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
			allwinner,bus-format = "rgb888";
			status = "okay";
		};

		/*
		 * ILITEK ILI3031B, 240x240 i8080 panel of the vendor board (default/linux-6.6-xuantie/lcd/ilitek_ili3031b.dtsi).
		 * PE15 reset, PE10 chip select (low = selected), PD22 backlight as a plain GPIO.
		 */
		panel_i8080: panel-i8080 {
			compatible = "allwinner,sunxi-panel";
			allwinner,gpio-controller = <&pio>;
			clock-frequency = <16000000>;
			hactive = <240>;
			vactive = <240>;
			hsync-len = <10>;
			hfront-porch = <20>;
			hback-porch = <10>;
			vsync-len = <4>;
			vfront-porch = <4>;
			vback-porch = <4>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
			allwinner,bus-format = "rgb565";
			power-on-sequence = <SUNXI_CMD_GPIO(SUNXI_PIN(SUNXI_GPIO_PORT_E, 15), 1)
					     SUNXI_CMD_DELAY(10)
					     SUNXI_CMD_GPIO(SUNXI_PIN(SUNXI_GPIO_PORT_E, 15), 0)
					     SUNXI_CMD_DELAY(200)
					     SUNXI_CMD_GPIO(SUNXI_PIN(SUNXI_GPIO_PORT_E, 15), 1)
					     SUNXI_CMD_DELAY(120)
					     SUNXI_CMD_GPIO(SUNXI_PIN(SUNXI_GPIO_PORT_E, 10), 0)>;
			power-off-sequence = <SUNXI_CMD_GPIO(SUNXI_PIN(SUNXI_GPIO_PORT_E, 10), 1)
					      SUNXI_CMD_GPIO(SUNXI_PIN(SUNXI_GPIO_PORT_E, 15), 0)
					      SUNXI_CMD_DELAY(100)>;
			init-sequence = <SUNXI_CMD_I8080(0, 3, 0xfd 0x06 0x08)
					 SUNXI_CMD_I8080(0, 3, 0x61 0x07 0x07)
					 SUNXI_CMD_I8080(0, 2, 0x73 0x70)
					 SUNXI_CMD_I8080(0, 2, 0x73 0x00)
					 SUNXI_CMD_I8080(0, 4, 0x62 0x00 0x44 0x40)
					 SUNXI_CMD_I8080(0, 5, 0x63 0x41 0x07 0x12 0x12)
					 SUNXI_CMD_I8080(0, 2, 0x64 0x37)
					 SUNXI_CMD_I8080(0, 4, 0x65 0x08 0x10 0x21)
					 SUNXI_CMD_I8080(0, 4, 0x66 0x08 0x10 0x21)
					 SUNXI_CMD_I8080(0, 3, 0x67 0x20 0x40)
					 SUNXI_CMD_I8080(0, 5, 0x68 0x90 0x30 0x77 0x5f)
					 SUNXI_CMD_I8080(0, 4, 0xb1 0x0f 0x02 0x01)
					 SUNXI_CMD_I8080(0, 2, 0xb4 0x01)
					 SUNXI_CMD_I8080(0, 5, 0xb5 0x02 0x02 0x0a 0x14)
					 SUNXI_CMD_I8080(0, 6, 0xb6 0x44 0x01 0x9f 0x00 0x02)
					 SUNXI_CMD_I8080(0, 2, 0xdf 0x11)
					 SUNXI_CMD_I8080(0, 7, 0xe2 0x02 0x02 0x04 0x2f 0x3b 0x3f)
					 SUNXI_CMD_I8080(0, 7, 0xe5 0x3f 0x3b 0x2e 0x03 0x02 0x03)
					 SUNXI_CMD_I8080(0, 3, 0xe1 0x0e 0x62)
					 SUNXI_CMD_I8080(0, 3, 0xe4 0x54 0x0f)
					 SUNXI_CMD_I8080(0, 9, 0xe0 0x05 0x06 0x0c 0x10 0x0d 0x0e 0x11 0x14)
					 SUNXI_CMD_I8080(0, 9, 0xe3 0x19 0x10 0x0d 0x0e 0x0d 0x0e 0x05 0x03)
					 SUNXI_CMD_I8080(0, 3, 0xe6 0x00 0xff)
					 SUNXI_CMD_I8080(0, 7, 0xe7 0x01 0x04 0x03 0x03 0x00 0x12)
					 SUNXI_CMD_I8080(0, 4, 0xe8 0x00 0x70 0x00)
					 SUNXI_CMD_I8080(0, 2, 0xec 0x52)
					 SUNXI_CMD_I8080(0, 4, 0xf1 0x01 0x01 0x02)
					 SUNXI_CMD_I8080(0, 5, 0xf6 0x01 0x30 0x00 0x00)
					 SUNXI_CMD_I8080(0, 3, 0xfd 0xfa 0xfc)
					 SUNXI_CMD_I8080(0, 2, 0x3a 0x05)
					 SUNXI_CMD_I8080(0, 2, 0x35 0x00)
					 SUNXI_CMD_I8080(0, 2, 0x36 0x00)
					 SUNXI_CMD_I8080(255, 1, 0x11)
					 SUNXI_CMD_I8080(10, 1, 0x29)
					 SUNXI_CMD_I8080(0, 1, 0x2c)>;
			vsync-sequence = <SUNXI_CMD_I8080(0, 1, 0x2c)>;
			exit-sequence = <SUNXI_CMD_I8080(0, 1, 0x28)
					 SUNXI_CMD_I8080(120, 1, 0x10)>;
			status = "okay";
		};

		backlight_i8080: backlight-i8080 {
			compatible = "allwinner,sunxi-backlight";
			enable-gpios = <&pio SUNXI_GPIO_PORT_D 22 1>;
			allwinner,active-high = <1>;
			status = "okay";
		};

		display0: display-subsystem {
			compatible = "allwinner,sunxi-display";
			allwinner,variant = "sun252iw1";
			allwinner,pll-video = <(SUNXI_CCU_BASE + 0x40)>;
			allwinner,pll-peri = <(SUNXI_CCU_BASE + 0x20)>;
			allwinner,de = <&de0>;
			allwinner,tcon = <&tcon_lcd0>;
			allwinner,tcon-top = <&tcon_top0>;
			allwinner,output = <&rgb0>;
			allwinner,panel = <&panel_rgb>;
			status = "okay";
		};

		display_srgb: display-subsystem-serial {
			compatible = "allwinner,sunxi-display";
			allwinner,variant = "sun252iw1";
			allwinner,pll-video = <(SUNXI_CCU_BASE + 0x40)>;
			allwinner,pll-peri = <(SUNXI_CCU_BASE + 0x20)>;
			allwinner,de = <&de0>;
			allwinner,tcon = <&tcon_lcd0>;
			allwinner,tcon-top = <&tcon_top0>;
			allwinner,output = <&rgb_serial0>;
			allwinner,panel = <&panel_srgb>;
			status = "okay";
		};

		display_i8080: display-subsystem-i8080 {
			compatible = "allwinner,sunxi-display";
			allwinner,variant = "sun252iw1";
			allwinner,pll-video = <(SUNXI_CCU_BASE + 0x40)>;
			allwinner,pll-peri = <(SUNXI_CCU_BASE + 0x20)>;
			allwinner,de = <&de0>;
			allwinner,tcon = <&tcon_lcd0>;
			allwinner,tcon-top = <&tcon_top0>;
			allwinner,output = <&i8080_0>;
			allwinner,panel = <&panel_i8080>;
			allwinner,backlight = <&backlight_i8080>;
			status = "okay";
		};
	};
};

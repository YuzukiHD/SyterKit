/dts-v1/;

#include <dt-bindings/dram/dram-param.h>

#include <dt-bindings/gpio/sunxi-gpio.h>
#include <dt-bindings/soc/sun252iw1.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Avaota F2";
	compatible = "syterkit,avaota-f2";

	aliases {
		ccu0 = &ccu0;
		sid0 = &sid0;
		dram0 = &dram0;
		i2c0 = &i2c0;
		intc0 = &clic0;
		pmu0 = &pmu0;
	};

	chosen {
		stdout-path = &uart0;
	};

	ccu0: clock-controller@2001000 {
		compatible = "allwinner,sun252iw1-ccu";
		reg = <SUNXI_CCU_BASE 0x1000>;
		reg-names = "ccu";
		status = "okay";
	};

	dram0: dram-controller {
		compatible = "allwinner,sun252iw1-dram";
		allwinner,dram-parameters =
			<0x00000420>,
			<SUNXI_DRAM_DDR3>,
			<0x007b6bfb>,
			<0x00000001>,
			<0x000010d2>,
			<0x00000000>,
			<0x00001c70>,
			<0x00000002>,
			<0x00000018>,
			<0x00000000>,
			<0x004a2195>,
			<0x02423190>,
			<0x0008b061>,
			<0xb4787896>,
			<0x00000000>,
			<0x48484848>,
			<0x00000048>,
			<0x1621121e>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>,
			<0x00460000>,
			<0x00000055>,
			<0x34010100>;
		status = "okay";
	};

	pio: pinctrl@2000000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <SUNXI_GPIO_BASE 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		gpio-controller;
		#gpio-cells = <3>;

		uart0_pins: uart0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_H 13 6>,
				<SUNXI_GPIO_PORT_H 14 6>;
		};
	};

	r_pio: pinctrl@2000540 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <SUNXI_RGPIO_BASE 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_L>;
		allwinner,bank-count = <3>;
		gpio-controller;
		#gpio-cells = <3>;

		i2c0_pins: i2c0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_L 5 2>,
				<SUNXI_GPIO_PORT_L 6 2>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sid0: efuse@7091000 {
			compatible = "allwinner,sunxi-sid";
			reg = <SUNXI_SID_BASE 0x400>;
			status = "okay";
		};

		clic0: interrupt-controller@30800000 {
			compatible = "thead,c900-clic";
			reg = <SUNXI_RISCV_CLIC_BASE 0x2000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			riscv,num-sources = <208>;
			status = "okay";
		};

		i2c0: i2c@2502000 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <SUNXI_TWI0_BASE 0x400>;
			clock-frequency = <400000>;
			allwinner,i2c-id = <0>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x91c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x91c) 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_pins>;
			status = "okay";

			pmu0: pmic@36 {
				compatible = "x-powers,axp333";
				reg = <0x36>;
				status = "okay";
			};
		};

		uart0: serial@2500000 {
			compatible = "allwinner,sunxi-uart";
			reg = <SUNXI_UART0_BASE 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <0>;
			allwinner,clock-gate = <(SUNXI_CCU_BASE + 0x90c) 0>;
			allwinner,reset = <(SUNXI_CCU_BASE + 0x90c) 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_pins>;
			status = "okay";
		};
	};
};

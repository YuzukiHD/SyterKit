/dts-v1/;

#include <dt-bindings/dram/dram-param.h>

#include <dt-bindings/gpio/sunxi-gpio.h>
#include <dt-bindings/soc/sun8iw21.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "TinyVision";
	compatible = "syterkit,tinyvision";

	aliases {
		ccu0 = &ccu0;
		dma0 = &dma0;
		dram0 = &dram0;
		e907 = &e907;
		i2c0 = &i2c0;
		intc0 = &intc0;
		mmc0 = &mmc0;
		mmc2 = &mmc2;
		rtc0 = &rtc0;
		sid0 = &sid0;
		spi0 = &spi0;
		spi-nand0 = &spi_nand0;
		uart-e907 = &uart3;
		usb0 = &usb0;
	};

	chosen {
		stdout-path = &uart0;
	};

	ccu0: clock-controller@2001000 {
		compatible = "allwinner,sun8iw21-ccu";
		reg = <SUNXI_CCU_BASE 0x1000>;
		reg-names = "ccu";
		status = "okay";
	};

	dram_memory: memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x80000000>;
	};

	dram0: dram-controller {
		compatible = "allwinner,sun8iw21-dram";
		allwinner,dram-memory = <&dram_memory>;
		reg =
			<SUNXI_CCU_BASE 0x1000>,
			<SUNXI_MCTL_COM_BASE 0x1000>,
			<SUNXI_MCTL_PHY_BASE 0x1000>,
			<SUNXI_SYSCRL_BASE 0x1000>,
			<SUNXI_SID_BASE 0x1000>,
			<SUNXI_CPUS_CFG_BASE 0x400>,
			<SUNXI_RPRCM_BASE 0x400>;
		allwinner,dram-parameters =
			<0x00000210>,
			<SUNXI_DRAM_DDR2>,
			<0x007b7bf9>,
			<0x00000000>,
			<0x000000d2>,
			<0x00000000>,
			<0x00000e73>,
			<0x00000002>,
			<0x00000000>,
			<0x00000000>,
			<0x00471992>,
			<0x0131a10c>,
			<0x00057041>,
			<0xb4787896>,
			<0x00000000>,
			<0x48484848>,
			<0x00000048>,
			<0x1621121e>,
			<0x00000000>,
			<0x00000000>,
			<0x00000000>,
			<0x00000022>,
			<0x00000077>,
			<0x34000100>;
		allwinner,rtc = <&rtc0>;
		status = "okay";
	};

	pio: pinctrl@2000000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <SUNXI_PIO_BASE 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		gpio-controller;
		#gpio-cells = <3>;

		i2c0_pins: i2c0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_E 4 8>,
				<SUNXI_GPIO_PORT_E 5 8>;
		};

		mmc0_pins: mmc0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_F 2 2>,
				<SUNXI_GPIO_PORT_F 3 2>,
				<SUNXI_GPIO_PORT_F 1 2>,
				<SUNXI_GPIO_PORT_F 0 2>,
				<SUNXI_GPIO_PORT_F 5 2>,
				<SUNXI_GPIO_PORT_F 4 2>;
		};

		mmc2_pins: mmc2-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 0 3>,
				<SUNXI_GPIO_PORT_C 1 3>,
				<SUNXI_GPIO_PORT_C 4 3>,
				<SUNXI_GPIO_PORT_C 3 3>,
				<SUNXI_GPIO_PORT_C 2 3>,
				<SUNXI_GPIO_PORT_C 5 3>;
		};

		spi0_pins: spi0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 1 4>,
				<SUNXI_GPIO_PORT_C 0 4>,
				<SUNXI_GPIO_PORT_C 2 4>,
				<SUNXI_GPIO_PORT_C 3 4>;
		};

		uart0_pins: uart0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_H 9 5>,
				<SUNXI_GPIO_PORT_H 10 5>;
		};

		uart3_pins: uart3-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_E 0 7>,
				<SUNXI_GPIO_PORT_E 1 7>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mmc0_dma: dma-descriptors@40080000 {
			reg = <0x40080000 0x100000>;
			no-map;
		};

		remoteproc_firmware: firmware@40008000 {
			reg = <0x40008000 0x00078000>;
			no-map;
		};

		mmc2_dma: dma-descriptors@40180000 {
			reg = <0x40180000 0x100000>;
			no-map;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		rtc0: rtc@7090100 {
			compatible = "allwinner,sunxi-rtc";
			reg = <SUNXI_RTC_DATA_BASE 0x100>;
			status = "okay";
		};

		sid0: efuse@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <SUNXI_SID_BASE 0x400>;
			allwinner,efuse-hv-switch = <(SUNXI_RTC_BASE + 0x204)>;
			status = "okay";
		};

		e907: remoteproc@6010000 {
			compatible = "allwinner,sun8iw21-e907";
			reg = <SUNXI_CCU_BASE 0x1000>,
			      <SUNXI_RISCV_CFG_BASE 0x1000>;
			firmware-name = "e907.elf";
			memory-region = <&remoteproc_firmware>;
			allwinner,firmware-format = "elf32";
			status = "okay";
		};

		dma0: dma-controller@3002000 {
			compatible = "allwinner,sunxi-dma";
			reg = <SUNXI_DMA_BASE 0x1000>;
			#dma-cells = <1>;
			allwinner,mbus-clock-gate = <(SUNXI_CCM_BASE + 0x804) 0>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0x70c) 0>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0x70c) 16>;
			status = "okay";
		};

		intc0: interrupt-controller@3021000 {
			compatible = "arm,gic-400";
			reg = <SUNXI_GIC_BASE 0x1000>,
				<(SUNXI_GIC_BASE + 0x1000) 0x2000>;
			interrupt-controller;
			#interrupt-cells = <3>;
			allwinner,irq-count = <223>;
			status = "okay";
		};

		usb0: usb@4100000 {
			compatible = "allwinner,sunxi-musb";
			reg = <SUNXI_USB0_BASE 0x1000>;
			interrupts = <61>;
			allwinner,usb-id = <0>;
			allwinner,phy-clock = <(SUNXI_CCM_BASE + 0xa70) 31>;
			allwinner,phy-reset = <(SUNXI_CCM_BASE + 0xa70) 30>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0xa8c) 8>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0xa8c) 24>;
			status = "okay";
		};

		mmc0: mmc@4020000 {
			compatible = "allwinner,sunxi-mmc";
			reg = <SUNXI_SMHC0_BASE 0x1000>;
			label = "sdhci0";
			allwinner,mmc-id = <0>;
			bus-width = <4>;
			max-frequency = <50000000>;
			memory-region = <&mmc0_dma>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0x84c) 0>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0x84c) 16>;
			allwinner,module-clock =
				<(SUNXI_CCM_BASE + 0x830) 8 0 1>;
			allwinner,clock-source-rates =
				<24000000 400000000 300000000 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc0_pins>;
			status = "okay";
		};

		mmc2: mmc@4022000 {
			compatible = "allwinner,sunxi-mmc";
			reg = <SUNXI_SMHC2_BASE 0x1000>;
			label = "sdhci2";
			allwinner,mmc-id = <2>;
			bus-width = <4>;
			max-frequency = <50000000>;
			memory-region = <&mmc2_dma>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0x84c) 2>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0x84c) 18>;
			allwinner,module-clock =
				<(SUNXI_CCM_BASE + 0x838) 8 0 1>;
			allwinner,clock-source-rates =
				<24000000 400000000 300000000 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc2_pins>;
			status = "okay";
		};

		spi0: spi@4025000 {
			compatible = "allwinner,sunxi-spi";
			#address-cells = <1>;
			#size-cells = <0>;
			allwinner,spi-id = <0>;
			reg = <SUNXI_SPI0_BASE 0x1000>;
			clock-frequency = <75000000>;
			allwinner,module-clock = <(SUNXI_CCM_BASE + 0x940) 1 8 300000000 0>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0x96c) 0>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0x96c) 16>;
			dmas = <&dma0 22>;
			dma-names = "rx";
			allwinner,lcd-dc-gpio =
				<&pio SUNXI_GPIO_PORT_C 4 1>;
			allwinner,lcd-reset-gpio =
				<&pio SUNXI_GPIO_PORT_C 5 1>;
			pinctrl-names = "default";
			pinctrl-0 = <&spi0_pins>;
			status = "okay";

			spi_nand0: flash@0 {
				compatible = "spi-nand";
				reg = <0>;
				spi-max-frequency = <75000000>;
			};
		};

		i2c0: i2c@2502000 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <SUNXI_TWI0_BASE 0x400>;
			clock-frequency = <400000>;
			allwinner,i2c-id = <0>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0x91c) 0>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0x91c) 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_pins>;
			status = "okay";
		};

		uart0: serial@2500000 {
			compatible = "allwinner,sunxi-uart";
			reg = <SUNXI_UART0_BASE 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <0>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0x90c) 0>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0x90c) 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_pins>;
			status = "okay";
		};

		uart3: serial@2500c00 {
			compatible = "allwinner,sunxi-uart";
			reg = <SUNXI_UART3_BASE 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <3>;
			allwinner,clock-gate = <(SUNXI_CCM_BASE + 0x90c) 3>;
			allwinner,reset = <(SUNXI_CCM_BASE + 0x90c) 19>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart3_pins>;
			status = "okay";
		};
	};
};

/dts-v1/;

#include <dt-bindings/gpio/sunxi-gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "TinyVision";
	compatible = "syterkit,tinyvision";

	aliases {
		ccu0 = &ccu0;
		dma0 = &dma0;
		dram0 = &dram0;
		e907 = &e907;
		i2c0 = &i2c0;
		intc0 = &intc0;
		mmc0 = &mmc0;
		mmc2 = &mmc2;
		rtc0 = &rtc0;
		sid0 = &sid0;
		spi0 = &spi0;
		spi-nand0 = &spi_nand0;
		uart-e907 = &uart3;
		usb0 = &usb0;
	};

	chosen {
		stdout-path = &uart0;
	};

	ccu0: clock-controller@2001000 {
		compatible = "allwinner,sun8iw21-ccu";
		reg = <0x02001000 0x1000>;
		reg-names = "ccu";
		status = "okay";
	};

	dram_memory: memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x80000000>;
	};

	dram0: dram-controller {
		compatible = "allwinner,sun8iw21-dram";
		allwinner,dram-memory = <&dram_memory>;
		reg =
			<0x02001000 0x1000>,
			<0x03102000 0x1000>,
			<0x03103000 0x1000>,
			<0x03000000 0x1000>,
			<0x03006000 0x1000>,
			<0x07000400 0x400>,
			<0x07010000 0x400>;
		allwinner,dram-parameters =
			<528 2 0x007b7bf9 0 0x000000d2 0>,
			<0x00000e73 0x00000002 0 0 0x00471992 0x0131a10c>,
			<0x00057041 0xb4787896 0 0x48484848 0x00000048 0x1621121e>,
			<0 0 0 0x00000022 0x00000077 0x34000100>;
		allwinner,rtc = <&rtc0>;
		status = "okay";
	};

	pio: pinctrl@2000000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <0x02000000 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		gpio-controller;
		#gpio-cells = <3>;

		i2c0_pins: i2c0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_E 4 8>,
				<SUNXI_GPIO_PORT_E 5 8>;
		};

		mmc0_pins: mmc0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_F 2 2>,
				<SUNXI_GPIO_PORT_F 3 2>,
				<SUNXI_GPIO_PORT_F 1 2>,
				<SUNXI_GPIO_PORT_F 0 2>,
				<SUNXI_GPIO_PORT_F 5 2>,
				<SUNXI_GPIO_PORT_F 4 2>;
		};

		mmc2_pins: mmc2-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 0 3>,
				<SUNXI_GPIO_PORT_C 1 3>,
				<SUNXI_GPIO_PORT_C 4 3>,
				<SUNXI_GPIO_PORT_C 3 3>,
				<SUNXI_GPIO_PORT_C 2 3>,
				<SUNXI_GPIO_PORT_C 5 3>;
		};

		spi0_pins: spi0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_C 1 4>,
				<SUNXI_GPIO_PORT_C 0 4>,
				<SUNXI_GPIO_PORT_C 2 4>,
				<SUNXI_GPIO_PORT_C 3 4>;
		};

		uart0_pins: uart0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_H 9 5>,
				<SUNXI_GPIO_PORT_H 10 5>;
		};

		uart3_pins: uart3-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_E 0 7>,
				<SUNXI_GPIO_PORT_E 1 7>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mmc0_dma: dma-descriptors@40080000 {
			reg = <0x40080000 0x100000>;
			no-map;
		};

		remoteproc_firmware: firmware@40008000 {
			reg = <0x40008000 0x00078000>;
			no-map;
		};

		mmc2_dma: dma-descriptors@40180000 {
			reg = <0x40180000 0x100000>;
			no-map;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		rtc0: rtc@7090100 {
			compatible = "allwinner,sunxi-rtc";
			reg = <0x07090100 0x100>;
			status = "okay";
		};

		sid0: efuse@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <0x03006000 0x400>;
			allwinner,efuse-hv-switch = <0x07090204>;
			status = "okay";
		};

		e907: remoteproc@6010000 {
			compatible = "allwinner,sun8iw21-e907";
			reg = <0x02001000 0x1000>,
			      <0x06010000 0x1000>;
			firmware-name = "e907.elf";
			memory-region = <&remoteproc_firmware>;
			allwinner,firmware-format = "elf32";
			status = "okay";
		};

		dma0: dma-controller@3002000 {
			compatible = "allwinner,sunxi-dma";
			reg = <0x03002000 0x1000>;
			#dma-cells = <1>;
			allwinner,mbus-clock-gate = <0x02001804 0>;
			allwinner,clock-gate = <0x0200170c 0>;
			allwinner,reset = <0x0200170c 16>;
			status = "okay";
		};

		intc0: interrupt-controller@3021000 {
			compatible = "arm,gic-400";
			reg = <0x03021000 0x1000>,
				<0x03022000 0x2000>;
			interrupt-controller;
			#interrupt-cells = <3>;
			allwinner,irq-count = <223>;
			status = "okay";
		};

		usb0: usb@4100000 {
			compatible = "allwinner,sunxi-musb";
			reg = <0x04100000 0x1000>;
			interrupts = <61>;
			allwinner,usb-id = <0>;
			allwinner,phy-clock = <0x02001a70 31>;
			allwinner,phy-reset = <0x02001a70 30>;
			allwinner,clock-gate = <0x02001a8c 8>;
			allwinner,reset = <0x02001a8c 24>;
			status = "okay";
		};

		mmc0: mmc@4020000 {
			compatible = "allwinner,sunxi-mmc";
			reg = <0x04020000 0x1000>;
			label = "sdhci0";
			allwinner,mmc-id = <0>;
			bus-width = <4>;
			max-frequency = <50000000>;
			memory-region = <&mmc0_dma>;
			allwinner,clock-gate = <0x0200184c 0>;
			allwinner,reset = <0x0200184c 16>;
			allwinner,module-clock =
				<0x02001830 8 0 1>;
			allwinner,clock-source-rates =
				<24000000 400000000 300000000 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc0_pins>;
			status = "okay";
		};

		mmc2: mmc@4022000 {
			compatible = "allwinner,sunxi-mmc";
			reg = <0x04022000 0x1000>;
			label = "sdhci2";
			allwinner,mmc-id = <2>;
			bus-width = <4>;
			max-frequency = <50000000>;
			memory-region = <&mmc2_dma>;
			allwinner,clock-gate = <0x0200184c 2>;
			allwinner,reset = <0x0200184c 18>;
			allwinner,module-clock =
				<0x02001838 8 0 1>;
			allwinner,clock-source-rates =
				<24000000 400000000 300000000 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&mmc2_pins>;
			status = "okay";
		};

		spi0: spi@4025000 {
			compatible = "allwinner,sunxi-spi";
			#address-cells = <1>;
			#size-cells = <0>;
			allwinner,spi-id = <0>;
			reg = <0x04025000 0x1000>;
			clock-frequency = <75000000>;
			allwinner,module-clock = <0x02001940 1 8 300000000 0>;
			allwinner,clock-gate = <0x0200196c 0>;
			allwinner,reset = <0x0200196c 16>;
			dmas = <&dma0 22>;
			dma-names = "rx";
			allwinner,lcd-dc-gpio =
				<&pio SUNXI_GPIO_PORT_C 4 1>;
			allwinner,lcd-reset-gpio =
				<&pio SUNXI_GPIO_PORT_C 5 1>;
			pinctrl-names = "default";
			pinctrl-0 = <&spi0_pins>;
			status = "okay";

			spi_nand0: flash@0 {
				compatible = "spi-nand";
				reg = <0>;
				spi-max-frequency = <75000000>;
			};
		};

		i2c0: i2c@2502000 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x02502000 0x400>;
			clock-frequency = <400000>;
			allwinner,i2c-id = <0>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <0x0200191c 0>;
			allwinner,reset = <0x0200191c 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_pins>;
			status = "okay";
		};

		uart0: serial@2500000 {
			compatible = "allwinner,sunxi-uart";
			reg = <0x02500000 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <0>;
			allwinner,clock-gate = <0x0200190c 0>;
			allwinner,reset = <0x0200190c 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_pins>;
			status = "okay";
		};

		uart3: serial@2500c00 {
			compatible = "allwinner,sunxi-uart";
			reg = <0x02500c00 0x400>;
			current-speed = <115200>;
			clock-frequency = <24000000>;
			allwinner,uart-id = <3>;
			allwinner,clock-gate = <0x0200190c 3>;
			allwinner,reset = <0x0200190c 19>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart3_pins>;
			status = "okay";
		};
	};
};

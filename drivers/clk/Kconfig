menu "Clock driver"

config DRIVER_CLK
	bool "Clock controller support"

choice
	prompt "Clock driver log level"
	default DRIVER_CLK_LOG_TRACE if BUILD_TRACE
	default DRIVER_CLK_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_CLK_LOG_GLOBAL
	depends on DRIVER_CLK

config DRIVER_CLK_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_CLK_LOG_MUTE
	bool "Mute"

config DRIVER_CLK_LOG_ERROR
	bool "Error"

config DRIVER_CLK_LOG_WARNING
	bool "Warning"

config DRIVER_CLK_LOG_INFO
	bool "Info"

config DRIVER_CLK_LOG_DEBUG
	bool "Debug"

config DRIVER_CLK_LOG_TRACE
	bool "Trace"

config DRIVER_CLK_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

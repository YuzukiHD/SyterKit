menu "MMC driver"

config DRIVER_MMC
	bool "MMC controller support"

config DRIVER_MMC_TUNING
	bool "eMMC HS200/HS400 tuning"
	depends on DRIVER_MMC
	help
	  Enable eMMC HS200 and HS400 mode selection and sampling-point tuning.
	  This adds code and runtime initialization time, so leave it disabled
	  when only legacy, HS or DDR52 operation is required.

choice
	prompt "MMC driver log level"
	default DRIVER_MMC_LOG_TRACE if BUILD_TRACE
	default DRIVER_MMC_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_MMC_LOG_GLOBAL
	depends on DRIVER_MMC

config DRIVER_MMC_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_MMC_LOG_MUTE
	bool "Mute"

config DRIVER_MMC_LOG_ERROR
	bool "Error"

config DRIVER_MMC_LOG_WARNING
	bool "Warning"

config DRIVER_MMC_LOG_INFO
	bool "Info"

config DRIVER_MMC_LOG_DEBUG
	bool "Debug"

config DRIVER_MMC_LOG_TRACE
	bool "Trace"

config DRIVER_MMC_LOG_BACKTRACE
	bool "Backtrace"

endchoice

source "drivers/mmc/host/Kconfig"

endmenu

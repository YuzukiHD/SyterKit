menu "Remote processor driver"

config DRIVER_REMOTEPROC
	bool "Remote processor support"

config DRIVER_REMOTEPROC_SUN8IW20_C906
	bool "Use C906 remote processor on Sun8iW20"
	depends on DRIVER_REMOTEPROC && SOC_SUN8IW20

choice
	prompt "Remote processor driver log level"
	default DRIVER_REMOTEPROC_LOG_TRACE if BUILD_TRACE
	default DRIVER_REMOTEPROC_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_REMOTEPROC_LOG_GLOBAL
	depends on DRIVER_REMOTEPROC

config DRIVER_REMOTEPROC_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_REMOTEPROC_LOG_MUTE
	bool "Mute"

config DRIVER_REMOTEPROC_LOG_ERROR
	bool "Error"

config DRIVER_REMOTEPROC_LOG_WARNING
	bool "Warning"

config DRIVER_REMOTEPROC_LOG_INFO
	bool "Info"

config DRIVER_REMOTEPROC_LOG_DEBUG
	bool "Debug"

config DRIVER_REMOTEPROC_LOG_TRACE
	bool "Trace"

config DRIVER_REMOTEPROC_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

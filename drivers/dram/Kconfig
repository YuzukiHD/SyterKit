menu "DRAM driver"

config DRIVER_DRAM
	bool "DRAM controller support"

choice
	prompt "DRAM driver log level"
	default DRIVER_DRAM_LOG_TRACE if BUILD_TRACE
	default DRIVER_DRAM_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_DRAM_LOG_GLOBAL
	depends on DRIVER_DRAM

config DRIVER_DRAM_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_DRAM_LOG_MUTE
	bool "Mute"

config DRIVER_DRAM_LOG_ERROR
	bool "Error"

config DRIVER_DRAM_LOG_WARNING
	bool "Warning"

config DRIVER_DRAM_LOG_INFO
	bool "Info"

config DRIVER_DRAM_LOG_DEBUG
	bool "Debug"

config DRIVER_DRAM_LOG_TRACE
	bool "Trace"

config DRIVER_DRAM_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

menu "PCIe driver"

config DRIVER_PCIE
	bool "PCIe controller support"
	depends on SOC_SUN55IW6
	help
	  Enable the layered PCIe controller driver for the sun55iw6.
	  The DesignWare controller and INNO PHY are initialized only when
	  board code calls the RC or EP entry point.

config DRIVER_PCIE_RC
	bool "PCIe root complex support"
	depends on DRIVER_PCIE
	default y
	help
	  Provide root-complex setup, link training and configuration-space access.

config DRIVER_PCIE_EP
	bool "PCIe endpoint support"
	depends on DRIVER_PCIE
	default y
	help
	  Provide endpoint header, BAR, iATU, MSI and LTSSM operations.

choice
	prompt "PCIe driver log level"
	default DRIVER_PCIE_LOG_TRACE if BUILD_TRACE
	default DRIVER_PCIE_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_PCIE_LOG_GLOBAL
	depends on DRIVER_PCIE

config DRIVER_PCIE_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_PCIE_LOG_MUTE
	bool "Mute"

config DRIVER_PCIE_LOG_ERROR
	bool "Error"

config DRIVER_PCIE_LOG_WARNING
	bool "Warning"

config DRIVER_PCIE_LOG_INFO
	bool "Info"

config DRIVER_PCIE_LOG_DEBUG
	bool "Debug"

config DRIVER_PCIE_LOG_TRACE
	bool "Trace"

config DRIVER_PCIE_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

menu "DMA driver"

config DRIVER_DMA
	bool "DMA controller support"

choice
	prompt "DMA driver log level"
	default DRIVER_DMA_LOG_TRACE if BUILD_TRACE
	default DRIVER_DMA_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_DMA_LOG_GLOBAL
	depends on DRIVER_DMA

config DRIVER_DMA_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_DMA_LOG_MUTE
	bool "Mute"

config DRIVER_DMA_LOG_ERROR
	bool "Error"

config DRIVER_DMA_LOG_WARNING
	bool "Warning"

config DRIVER_DMA_LOG_INFO
	bool "Info"

config DRIVER_DMA_LOG_DEBUG
	bool "Debug"

config DRIVER_DMA_LOG_TRACE
	bool "Trace"

config DRIVER_DMA_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

menu "PWM driver"

config DRIVER_PWM
	bool "PWM controller support"

choice
	prompt "PWM driver log level"
	default DRIVER_PWM_LOG_TRACE if BUILD_TRACE
	default DRIVER_PWM_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_PWM_LOG_GLOBAL
	depends on DRIVER_PWM

config DRIVER_PWM_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_PWM_LOG_MUTE
	bool "Mute"

config DRIVER_PWM_LOG_ERROR
	bool "Error"

config DRIVER_PWM_LOG_WARNING
	bool "Warning"

config DRIVER_PWM_LOG_INFO
	bool "Info"

config DRIVER_PWM_LOG_DEBUG
	bool "Debug"

config DRIVER_PWM_LOG_TRACE
	bool "Trace"

config DRIVER_PWM_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

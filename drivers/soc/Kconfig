menu "SoC driver"

config DRIVER_SOC
	bool "Allwinner SoC identification support"

choice
	prompt "SoC driver log level"
	default DRIVER_SOC_LOG_TRACE if BUILD_TRACE
	default DRIVER_SOC_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_SOC_LOG_GLOBAL
	depends on DRIVER_SOC

config DRIVER_SOC_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_SOC_LOG_MUTE
	bool "Mute"

config DRIVER_SOC_LOG_ERROR
	bool "Error"

config DRIVER_SOC_LOG_WARNING
	bool "Warning"

config DRIVER_SOC_LOG_INFO
	bool "Info"

config DRIVER_SOC_LOG_DEBUG
	bool "Debug"

config DRIVER_SOC_LOG_TRACE
	bool "Trace"

config DRIVER_SOC_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

menu "PSRAM driver"

config DRIVER_PSRAM
	bool "PSRAM controller support"
	help
	  Initialize mapped SPI PSRAM on sun252iw1, or LPSRAM from its
	  parameter block on sun252iw2.

choice
	prompt "PSRAM driver log level"
	default DRIVER_PSRAM_LOG_TRACE if BUILD_TRACE
	default DRIVER_PSRAM_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_PSRAM_LOG_GLOBAL
	depends on DRIVER_PSRAM

config DRIVER_PSRAM_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_PSRAM_LOG_MUTE
	bool "Mute"

config DRIVER_PSRAM_LOG_ERROR
	bool "Error"

config DRIVER_PSRAM_LOG_WARNING
	bool "Warning"

config DRIVER_PSRAM_LOG_INFO
	bool "Info"

config DRIVER_PSRAM_LOG_DEBUG
	bool "Debug"

config DRIVER_PSRAM_LOG_TRACE
	bool "Trace"

config DRIVER_PSRAM_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

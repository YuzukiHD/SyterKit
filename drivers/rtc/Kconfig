menu "RTC driver"

config DRIVER_RTC
	bool "Real-time clock support"

choice
	prompt "RTC driver log level"
	default DRIVER_RTC_LOG_TRACE if BUILD_TRACE
	default DRIVER_RTC_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_RTC_LOG_GLOBAL
	depends on DRIVER_RTC

config DRIVER_RTC_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_RTC_LOG_MUTE
	bool "Mute"

config DRIVER_RTC_LOG_ERROR
	bool "Error"

config DRIVER_RTC_LOG_WARNING
	bool "Warning"

config DRIVER_RTC_LOG_INFO
	bool "Info"

config DRIVER_RTC_LOG_DEBUG
	bool "Debug"

config DRIVER_RTC_LOG_TRACE
	bool "Trace"

config DRIVER_RTC_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

menu "UFS driver"

config DRIVER_UFS
	bool "UFS storage support"
	help
	  Enable the layered UFS stack.  The ufshc layer implements UFSHCI,
	  the SCSI layer implements block commands, and the top-level UFS
	  layer exposes the storage device to board code.

choice
	prompt "UFS driver log level"
	default DRIVER_UFS_LOG_TRACE if BUILD_TRACE
	default DRIVER_UFS_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_UFS_LOG_GLOBAL
	depends on DRIVER_UFS

config DRIVER_UFS_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_UFS_LOG_MUTE
	bool "Mute"

config DRIVER_UFS_LOG_ERROR
	bool "Error"

config DRIVER_UFS_LOG_WARNING
	bool "Warning"

config DRIVER_UFS_LOG_INFO
	bool "Info"

config DRIVER_UFS_LOG_DEBUG
	bool "Debug"

config DRIVER_UFS_LOG_TRACE
	bool "Trace"

config DRIVER_UFS_LOG_BACKTRACE
	bool "Backtrace"

endchoice

source "drivers/ufs/host/Kconfig"

endmenu

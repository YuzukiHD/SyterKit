menu "I2C driver"

config DRIVER_I2C
	bool "I2C controller support"

choice
	prompt "I2C driver log level"
	default DRIVER_I2C_LOG_TRACE if BUILD_TRACE
	default DRIVER_I2C_LOG_DEBUG if BUILD_DEBUG
	default DRIVER_I2C_LOG_GLOBAL
	depends on DRIVER_I2C

config DRIVER_I2C_LOG_GLOBAL
	bool "Inherit global log level"

config DRIVER_I2C_LOG_MUTE
	bool "Mute"

config DRIVER_I2C_LOG_ERROR
	bool "Error"

config DRIVER_I2C_LOG_WARNING
	bool "Warning"

config DRIVER_I2C_LOG_INFO
	bool "Info"

config DRIVER_I2C_LOG_DEBUG
	bool "Debug"

config DRIVER_I2C_LOG_TRACE
	bool "Trace"

config DRIVER_I2C_LOG_BACKTRACE
	bool "Backtrace"

endchoice

endmenu

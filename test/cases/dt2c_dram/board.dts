			<0x00000015>,
			<0x00000016>,
			<0x00000017>;
		status = "okay";
	};

	dram24_non_memory: dram-controller-24-non-memory {
		compatible = "allwinner,sun8iw20-dram";
		allwinner,dram-memory = <&dram_init_code>;
		reg = <0x16000000 0x1000>,
		      <0x16002000 0x1000>,
		      <0x16003000 0x1000>,
		      <0x16004000 0x1000>,
		      <0x16005000 0x1000>,
		      <0x16006000 0x400>,
		      <0x16007000 0x400>;
		allwinner,dram-parameters =
			<0x00000000>,
			<0x00000001>,
			<0x00000002>,
			<0x00000003>,
			<0x00000004>,
			<0x00000005>,
			<0x00000006>,
			<0x00000007>,
			<0x00000008>,
			<0x00000009>,
			<0x0000000a>,
			<0x0000000b>,
			<0x0000000c>,
			<0x0000000d>,
			<0x0000000e>,
			<0x0000000f>,
			<0x00000010>,
			<0x00000011>,
			<0x00000012>,
			<0x00000013>,
			<0x00000014>,
			<0x00000015>,
			<0x00000016>,
			<0x00000017>;
		status = "okay";
	};

	dram21: dram-controller-21 {
		compatible = "allwinner,sun8iw21-dram";
		allwinner,dram-memory = <&dram_memory0>;
		reg = <0x12000000 0x1000>,
		      <0x12002000 0x1000>,
		      <0x12003000 0x1000>,
		      <0x12004000 0x1000>,
		      <0x12005000 0x1000>,

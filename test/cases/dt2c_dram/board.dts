		allwinner,rtc = <&rtc0>;
		status = "okay";
	};

	dram300: dram-controller-300 {
		compatible = "allwinner,sun300iw1-dram";
		allwinner,dram-memory = <&dram_memory1>;
		reg = <0x20001000 0x1000>,
		      <0x20002000 0x1000>,
		      <0x20003000 0x1000>,
		      <0x20004000 0x1000>,
		      <0x20005000 0x1000>,

/dts-v1/;

#include <dt-bindings/gpio/sunxi-gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		dram24 = &dram24;
		dram24-alt = &dram24_alt;
		dram24-short-reg = &dram24_short_reg;
		dram24-no-memory = &dram24_no_memory;
		dram24-non-memory = &dram24_non_memory;
		dram21 = &dram21;
		dram300 = &dram300;
		dram32 = &dram32;
		dram50iw9 = &dram50iw9;
		dram50iw9-short-region = &dram50iw9_short_region;
		dram25 = &dram25;
		dram32-no-pmu = &dram32_no_pmu;
		dram-disabled = &dram_disabled;
		pmu0 = &pmu0;
		pmu1 = &pmu1;
		i2c0 = &i2c0;
		rtc0 = &rtc0;
	};

	dram_memory0: memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x20000000>;
	};

	dram_memory1: memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		dram_init_code: dram-init-code@48000 {
			reg = <0x00048000 0x00008000>;
			no-map;
		};

		dram_init_code_short: dram-init-code@58000 {
			reg = <0x00058000 0x2>;
			no-map;
		};
	};

	rtc0: rtc@1000 {
		compatible = "allwinner,sunxi-rtc";
		reg = <0x1000 0x100>;
		status = "okay";
	};

	pio: pinctrl@2000000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <0x02000000 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_A>;
		allwinner,bank-count = <11>;
		#gpio-cells = <3>;
		gpio-controller;
	};

	r_pio: pinctrl@7022000 {
		compatible = "allwinner,sunxi-pinctrl";
		reg = <0x07022000 0x1000>;
		allwinner,bank-base = <SUNXI_GPIO_PORT_L>;
		allwinner,bank-count = <3>;
		#gpio-cells = <3>;
		gpio-controller;

		i2c0_pins: i2c0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_L 0 2>,
				<SUNXI_GPIO_PORT_L 1 2>;
		};
	};

	i2c0: i2c@3000 {
		compatible = "allwinner,sunxi-i2c";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x3000 0x400>;
		clock-frequency = <400000>;
		allwinner,i2c-id = <6>;
		allwinner,parent-clock-frequency = <24000000>;
		allwinner,clock-gate = <0x4000 0>;
		allwinner,reset = <0x4000 16>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_pins>;
		status = "okay";

		pmu0: pmic@34 {
			compatible = "x-powers,axp2202";
			reg = <0x34>;
			status = "okay";
		};

		pmu1: pmic@36 {
			compatible = "x-powers,axp1530";
			reg = <0x36>;
			status = "okay";
		};
	};

	dram24: dram-controller-24 {
		compatible = "allwinner,sun8iw20-dram";
		allwinner,dram-memory = <&dram_memory0>;
		reg = <0x10000000 0x1000>,
		      <0x10002000 0x1000>,
		      <0x10003000 0x1000>,
		      <0x10004000 0x1000>,
		      <0x10005000 0x1000>,
		      <0x10006000 0x400>,
		      <0x10007000 0x400>;
		allwinner,dram-parameters =
			<0x00000100>,
			<0x00000101>,
			<0x00000102>,
			<0x00000103>,
			<0x00000104>,
			<0x00000105>,
			<0x00000106>,
			<0x00000107>,
			<0x00000108>,
			<0x00000109>,
			<0x0000010a>,
			<0x0000010b>,
			<0x0000010c>,
			<0x0000010d>,
			<0x0000010e>,
			<0x0000010f>,
			<0x00000110>,
			<0x00000111>,
			<0x00000112>,
			<0x00000113>,
			<0x00000114>,
			<0x00000115>,
			<0x00000116>,
			<0x00000117>;
		status = "okay";
	};

	dram24_alt: dram-controller-24-alt {
		compatible = "allwinner,sun8iw20-dram";
		allwinner,dram-memory = <&dram_memory1>;
		reg = <0x11000000 0x1000>,
		      <0x11002000 0x1000>,
		      <0x11003000 0x1000>,
		      <0x11004000 0x1000>,
		      <0x11005000 0x1000>,
		      <0x11006000 0x400>,
		      <0x11007000 0x400>;
		allwinner,dram-parameters =
			<0x00000300>,
			<0x00000301>,
			<0x00000302>,
			<0x00000303>,
			<0x00000304>,
			<0x00000305>,
			<0x00000306>,
			<0x00000307>,
			<0x00000308>,
			<0x00000309>,
			<0x0000030a>,
			<0x0000030b>,
			<0x0000030c>,
			<0x0000030d>,
			<0x0000030e>,
			<0x0000030f>,
			<0x00000310>,
			<0x00000311>,
			<0x00000312>,
			<0x00000313>,
			<0x00000314>,
			<0x00000315>,
			<0x00000316>,
			<0x00000317>;
		status = "okay";
	};

	dram24_short_reg: dram-controller-24-short-reg {
		compatible = "allwinner,sun8iw20-dram";
		allwinner,dram-memory = <&dram_memory0>;
		reg = <0x13000000 0x1000>,
		      <0x13002000 0x1000>,
		      <0x13003000 0x1000>,
		      <0x13004000 0x1000>,
		      <0x13005000 0x1000>,
		      <0x13006000 0x400>;
		allwinner,dram-parameters =
			<0x00000000>,
			<0x00000001>,
			<0x00000002>,
			<0x00000003>,
			<0x00000004>,
			<0x00000005>,
			<0x00000006>,
			<0x00000007>,
			<0x00000008>,
			<0x00000009>,
			<0x0000000a>,
			<0x0000000b>,
			<0x0000000c>,
			<0x0000000d>,
			<0x0000000e>,
			<0x0000000f>,
			<0x00000010>,
			<0x00000011>,
			<0x00000012>,
			<0x00000013>,
			<0x00000014>,
			<0x00000015>,
			<0x00000016>,
			<0x00000017>;
		status = "okay";
	};

	dram24_no_memory: dram-controller-24-no-memory {
		compatible = "allwinner,sun8iw20-dram";
		reg = <0x15000000 0x1000>,
		      <0x15002000 0x1000>,
		      <0x15003000 0x1000>,
		      <0x15004000 0x1000>,
		      <0x15005000 0x1000>,
		      <0x15006000 0x400>,
		      <0x15007000 0x400>;

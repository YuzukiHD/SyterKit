	dram32: dram-controller-32 {
		compatible = "allwinner,sun65iw1-dram";
		allwinner,dram-parameters =
			<0x00000200>,
			<0x00000201>,
			<0x00000202>,
			<0x00000203>,
			<0x00000204>,
			<0x00000205>,
			<0x00000206>,
			<0x00000207>,
			<0x00000208>,
			<0x00000209>,
			<0x0000020a>,
			<0x0000020b>,
			<0x0000020c>,
			<0x0000020d>,
			<0x0000020e>,
			<0x0000020f>,
			<0x00000210>,
			<0x00000211>,
			<0x00000212>,
			<0x00000213>,
			<0x00000214>,
			<0x00000215>,
			<0x00000216>,
			<0x00000217>,
			<0x00000218>,
			<0x00000219>,
			<0x0000021a>,
			<0x0000021b>,
			<0x0000021c>,
			<0x0000021d>,
			<0x0000021e>,
			<0x0000021f>;
		allwinner,primary-pmu = <&pmu0>;
		allwinner,secondary-pmu = <&pmu1>;
		status = "okay";
	};

	dram50iw9: dram-controller-50iw9 {
		compatible = "allwinner,sun50iw9-dram";

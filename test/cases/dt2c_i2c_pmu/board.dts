/dts-v1/;

#include <dt-bindings/gpio/sunxi-gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		pmu0 = &pmu0;
		pmu1 = &pmu1;
	};

	pinctrl {
		i2c0_pins: i2c0-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_L 0 2>,
				<SUNXI_GPIO_PORT_L 1 2>;
		};

		i2c1_pins: i2c1-pins {
			allwinner,pins =
				<SUNXI_GPIO_PORT_B 4 3>,
				<SUNXI_GPIO_PORT_B 5 3>;
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		i2c0: i2c@3000 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x3000 0x400>;
			clock-frequency = <400000>;
			allwinner,i2c-id = <6>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <0x4000 0>;
			allwinner,reset = <0x4000 16>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_pins>;
			status = "okay";

			pmu0: pmic@34 {
				compatible = "x-powers,axp2202";
				reg = <0x34>, <0x35>;
				status = "okay";
			};
		};

		i2c1: i2c@5000 {
			compatible = "allwinner,sunxi-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x5000 0x400>;
			clock-frequency = <100000>;
			allwinner,i2c-id = <1>;
			allwinner,parent-clock-frequency = <24000000>;
			allwinner,clock-gate = <0x6000 1>;
			allwinner,reset = <0x6000 17>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c1_pins>;
			status = "okay";

			pmu1: pmic@36 {
				compatible = "x-powers,axp1530";
				reg = <0x36>;
				status = "okay";
			};
		};
	};
};

# SPDX-License-Identifier: GPL-2.0+

CARGO ?= cargo

dt2c_source := $(srctree)/tools/dt2c
dt2c_prebuilt := $(srctree)/tools/bin/dt2c
dt2c_build_dir := $(objtree)/.obj/tools/dt2c
dt2c_bundled := $(dt2c_build_dir)/release/dt2c
dt2c_prebuilt_usable := $(shell \
	$(dt2c_prebuilt) generate --help >/dev/null 2>&1 && printf y)
dt2c_requested := $(DT2C)

ifeq ($(origin DT2C),undefined)
ifneq ($(dt2c_prebuilt_usable),)
dt2c_requested := $(dt2c_prebuilt)
else ifneq ($(wildcard $(dt2c_source)/Cargo.toml),)
dt2c_requested := $(dt2c_bundled)
else
dt2c_requested := dt2c
endif
endif

ifeq ($(abspath $(dt2c_requested)),$(dt2c_bundled))
dt2c_path := $(dt2c_bundled)
dt2c_build_target := $(dt2c_bundled)
else ifeq ($(abspath $(dt2c_requested)),$(dt2c_prebuilt))
dt2c_path := $(dt2c_prebuilt)
else
dt2c_command_path := $(shell command -v $(dt2c_requested) 2>/dev/null)
dt2c_path := $(if $(dt2c_command_path),$(abspath $(dt2c_command_path)))
endif

ifeq ($(origin DT2C_INCLUDE),undefined)
ifneq ($(filter $(dt2c_bundled) $(dt2c_prebuilt),$(dt2c_path)),)
dt2c_include_path := $(dt2c_source)/include
else
dt2c_include_path := $(shell \
	path='$(dt2c_path)'; dir=$${path%/*}; \
	for candidate in "$$dir/include" "$$dir/../include" \
		"$$dir/../../include"; do \
		if test -f "$$candidate/dt2c/dt.h"; then \
			cd "$$candidate" && pwd; break; \
		fi; \
	done)
endif
else
dt2c_include_path := $(abspath $(DT2C_INCLUDE))
endif

override DT2C := $(dt2c_path)
override DT2C_INCLUDE := $(dt2c_include_path)

dt2c_cargo_inputs := $(wildcard $(dt2c_source)/Cargo.toml \
	$(dt2c_source)/Cargo.lock $(dt2c_source)/src/*.rs \
	$(dt2c_source)/src/*/*.rs $(dt2c_source)/src/*/*/*.rs)

.PHONY: dt2c-check

$(dt2c_bundled): $(dt2c_cargo_inputs)
	@test -f $(dt2c_source)/Cargo.toml || { \
		echo "dt2c submodule is not initialized; run:" >&2; \
		echo "  git submodule update --init tools/dt2c" >&2; \
		exit 1; \
	}
	@command -v $(firstword $(CARGO)) >/dev/null 2>&1 || { \
		echo "cargo is required to build tools/dt2c; set DT2C=/path/to/dt2c to use a prebuilt binary" >&2; \
		exit 1; \
	}
	@echo "  CARGO   tools/dt2c"
	@CARGO_TARGET_DIR=$(dt2c_build_dir) \
		$(CARGO) build --locked --release \
		--manifest-path $(dt2c_source)/Cargo.toml

dt2c-check: $(dt2c_build_target)
	@test -x "$(dt2c_path)" || { \
		echo "dt2c was not found; set DT2C=/path/to/dt2c" >&2; \
		exit 1; \
	}
	@test -f "$(DT2C_INCLUDE)/dt2c/dt.h" || { \
		echo "dt2c headers were not found; set DT2C_INCLUDE=/path/to/include" >&2; \
		exit 1; \
	}

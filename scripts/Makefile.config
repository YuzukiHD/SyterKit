# SPDX-License-Identifier: GPL-2.0+

KCONFIG_CONFIG := $(objtree)/.config
auto_conf := $(objtree)/include/config/auto.conf
auto_header := $(objtree)/include/generated/autoconf.h
kconfig_out := $(objtree)/.kconfig
conf := $(kconfig_out)/conf
mconf := $(kconfig_out)/mconf

kconfig_sources := $(wildcard $(srctree)/scripts/kconfig/*.[ch] \
	$(srctree)/scripts/kconfig/*.y $(srctree)/scripts/kconfig/*.l \
	$(srctree)/scripts/kconfig/*.sh \
	$(srctree)/scripts/kconfig/lxdialog/*.[ch]) \
	$(srctree)/scripts/kconfig/Makefile
board_kconfig_list := $(kconfig_out)/boards.Kconfig
board_kconfigs := $(sort $(wildcard $(srctree)/boards/*/Kconfig))
soc_kconfig_list := $(kconfig_out)/soc.Kconfig
soc_kconfigs := $(sort $(wildcard $(srctree)/soc/*/Kconfig))

board_defconfig_files := $(sort $(wildcard $(srctree)/boards/*/configs/*_defconfig))
soc_defconfig_files := $(sort $(wildcard $(srctree)/soc/*/configs/*_defconfig))
defconfig_files := $(board_defconfig_files) $(soc_defconfig_files)

BOARD_KCONFIG_LIST := $(board_kconfig_list)
SOC_KCONFIG_LIST := $(soc_kconfig_list)
kconfig_env := KCONFIG_CONFIG=$(KCONFIG_CONFIG) \
	KCONFIG_AUTOCONFIG=$(auto_conf) KCONFIG_AUTOHEADER=$(auto_header) \
	BOARD_KCONFIG_LIST=$(BOARD_KCONFIG_LIST) SOC_KCONFIG_LIST=$(SOC_KCONFIG_LIST)

# GNU Make packs short command-line flags into the first MAKEFLAGS word
# (for example, -Bn becomes Bnps after the file adds -s).  Keep dry-run
# detection independent of long options such as --no-print-directory.
make_short_flags := $(firstword $(filter-out --%,$(MAKEFLAGS)))
make_dry_run := $(or \
	$(if $(filter-out --%,$(make_short_flags)),$(findstring n,$(make_short_flags))),\
	$(filter -n%,$(MAKEFLAGS)),\
	$(filter --just-print --dry-run,$(MAKEFLAGS)))

export make_dry_run

no_dot_config_targets := config menuconfig olddefconfig syncconfig defconfig \
	savedefconfig %_defconfig release clean mrproper help list-defconfigs \
	list-defconfig-targets dt2c-check tools utilities list-utilities test docs check

# A usable configuration consists of both the source `.config` and Kconfig's
# generated dependency file.  Keep this check as a phony target so callers can
# use it without adding a generated file to the build graph.
config_ready := $(and $(wildcard $(KCONFIG_CONFIG)),$(wildcard $(auto_conf)))

# Configuration is parsed before the rest of the build graph.  Combining a
# configuration goal with an image or application goal would therefore build
# against the configuration that existed when make started, not the one the
# configuration recipe writes.  Reject that ambiguous invocation early.
config_goals := $(filter config menuconfig olddefconfig syncconfig defconfig \
	savedefconfig release %_defconfig,$(MAKECMDGOALS))
build_goals := $(filter-out $(no_dot_config_targets),$(MAKECMDGOALS))
ifneq ($(strip $(config_goals)),)
ifneq ($(strip $(build_goals)),)
$(error Cannot combine configuration goal(s) [$(config_goals)] with build goal(s) \
[$(build_goals)]; run them as separate make commands)
endif
endif

ifeq ($(strip $(MAKECMDGOALS)),)
-include $(auto_conf)
-include $(auto_conf).cmd
else ifneq ($(strip $(filter-out $(no_dot_config_targets),$(MAKECMDGOALS))),)
-include $(auto_conf)
-include $(auto_conf).cmd
endif

.PHONY: config menuconfig olddefconfig syncconfig defconfig savedefconfig \
	release list-defconfigs list-defconfig-targets board-kconfig soc-kconfig \
	require-config

require-config:
	@test -f "$(KCONFIG_CONFIG)" && test -f "$(auto_conf)" || { \
		echo "No configuration found. Run 'make <board-or-soc>[_<variant>]_defconfig' or 'make menuconfig' first." >&2; \
		exit 1; \
	}

$(conf) $(mconf): $(kconfig_sources)
	@if test -n "$(make_dry_run)"; then exit 0; fi; \
	$(MAKE) -C $(srctree)/scripts/kconfig O=$(kconfig_out) \
		HOSTCC="$(HOSTCC)" all

board-kconfig:
	@set -e; \
	mkdir -p $(dir $(board_kconfig_list)); \
	tmp=$(board_kconfig_list).tmp.$$$$; \
	{ for file in $(board_kconfigs); do \
		printf 'source "%s"\n' "$${file#$(srctree)/}"; \
	done; } > "$$tmp"; \
	if ! cmp -s "$$tmp" $(board_kconfig_list); then \
		mv "$$tmp" $(board_kconfig_list); \
	else \
		$(RM) "$$tmp"; \
	fi

soc-kconfig:
	@set -e; \
	mkdir -p $(dir $(soc_kconfig_list)); \
	tmp=$(soc_kconfig_list).tmp.$$$$; \
	{ for file in $(soc_kconfigs); do \
		printf 'source "%s"\n' "$${file#$(srctree)/}"; \
	done; } > "$$tmp"; \
	if ! cmp -s "$$tmp" $(soc_kconfig_list); then \
		mv "$$tmp" $(soc_kconfig_list); \
	else \
		$(RM) "$$tmp"; \
	fi

config: $(conf) | board-kconfig soc-kconfig
	@mkdir -p $(objtree)
	@$(kconfig_env) $(conf) $(srctree)/Kconfig
	@if test -n "$(make_dry_run)"; then exit 0; fi; \
	$(MAKE) O=$(O) syncconfig

menuconfig: $(mconf) | board-kconfig soc-kconfig
	@mkdir -p $(objtree)
	@$(kconfig_env) $(mconf) $(srctree)/Kconfig
	@if test -n "$(make_dry_run)"; then exit 0; fi; \
	$(MAKE) O=$(O) syncconfig

olddefconfig: $(conf) | board-kconfig soc-kconfig
	@$(kconfig_env) $(conf) --olddefconfig $(srctree)/Kconfig
	@if test -n "$(make_dry_run)"; then exit 0; fi; \
	$(MAKE) O=$(O) syncconfig

release: $(conf) | board-kconfig soc-kconfig
	@test -f $(KCONFIG_CONFIG) || { \
		echo "No configuration found. Run 'make <board-or-soc>_defconfig' first." >&2; \
		exit 1; \
	}
	@set -e; \
	tmp="$(KCONFIG_CONFIG).release.$$$$"; \
	trap '$(RM) "$$tmp"' EXIT; \
	$(srctree)/scripts/release-config.sh "$(KCONFIG_CONFIG)" "$$tmp"; \
	$(kconfig_env) $(conf) --defconfig="$$tmp" $(srctree)/Kconfig
	@if test -n "$(make_dry_run)"; then exit 0; fi; \
	$(MAKE) O=$(O) syncconfig

syncconfig: $(conf) | board-kconfig soc-kconfig
	@mkdir -p $(dir $(auto_conf)) $(dir $(auto_header))
	@$(kconfig_env) $(conf) --syncconfig $(srctree)/Kconfig

$(auto_conf) $(auto_header) &: $(KCONFIG_CONFIG) $(conf) | board-kconfig soc-kconfig
	@if test -n "$(make_dry_run)"; then exit 0; fi; \
	set -e; \
	mkdir -p $(dir $(auto_conf)) $(dir $(auto_header)); \
	$(kconfig_env) $(conf) --syncconfig $(srctree)/Kconfig

defconfig: tinyvision_sram_defconfig

defconfig_platform = $(notdir $(patsubst %/configs/,%,$(dir $(1))))
defconfig_target = $(call defconfig_platform,$(1))_$(notdir $(1))
defconfig_source = $(strip $(foreach config,$(defconfig_files),\
	$(if $(filter $(1),$(call defconfig_target,$(config))),$(config))))

board_defconfig_targets := $(foreach config,$(board_defconfig_files),$(call defconfig_target,$(config)))
soc_defconfig_targets := $(foreach config,$(soc_defconfig_files),$(call defconfig_target,$(config)))
all_defconfig_targets := $(board_defconfig_targets) $(soc_defconfig_targets)
defconfig_targets := $(sort $(all_defconfig_targets))
board_defconfig_names := $(sort $(foreach config,$(board_defconfig_files),$(call defconfig_platform,$(config))))

ifneq ($(words $(all_defconfig_targets)),$(words $(defconfig_targets)))
$(error Duplicate defconfig target names were found under boards/ or soc/)
endif

.PHONY: $(defconfig_targets)
$(defconfig_targets): $(conf) | board-kconfig soc-kconfig
	@set -e; \
	config="$(call defconfig_source,$@)"; \
	mkdir -p $(objtree); \
	echo "  DEFCONFIG  $@"; \
	$(kconfig_env) $(conf) --defconfig="$$config" $(srctree)/Kconfig
	@if test -n "$(make_dry_run)"; then exit 0; fi; \
	$(MAKE) O=$(O) syncconfig

%_defconfig:
	@echo "Unknown defconfig: $@"
	@false

savedefconfig: $(conf) | board-kconfig soc-kconfig
	@$(kconfig_env) $(conf) \
		--savedefconfig=$(objtree)/defconfig $(srctree)/Kconfig

list-defconfigs:
	@printf 'Board:\n'; \
	for board_name in $(board_defconfig_names); do \
		printf '  %s:\n' "$$board_name"; \
		for config in $(srctree)/boards/$$board_name/configs/*_defconfig; do \
			printf '    %s_%s\n' "$$board_name" "$${config##*/}"; \
		done; \
	done; \
	printf 'SoC:\n'; \
	for target in $(soc_defconfig_targets); do \
		printf '  %s\n' "$$target"; \
	done

list-defconfig-targets:
	@for target in $(defconfig_targets); do printf '%s\n' "$$target"; done

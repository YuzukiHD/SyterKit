# SPDX-License-Identifier: GPL-2.0+

# Rust is an optional consumer of the existing C ABI. Keep the generated FFI
# layer, reusable drivers/core/lib crates, and each Rust app in separate Cargo target
# directories. This mirrors Kbuild's built-in objects while keeping app entry
# points from colliding with one another.
RUST_FFI_CARGO ?= $(if $(CARGO),$(CARGO),cargo)
RUST_FFI_HEADERS ?=
RUST_FFI_HEADER_MANIFEST ?= $(srctree)/rust/ffi/headers.txt
RUST_FFI_ALLOWLIST ?=
RUST_FFI_CLANG_ARGS ?=
RUST_FFI_RUSTFLAGS ?=
RUST_FFI_TARGET ?=
RUST_FFI_CLANG_TARGET ?=
RUST_FFI_LINKER_FLAGS ?=

rust_ffi_manifest := $(abspath $(RUST_FFI_HEADER_MANIFEST))
rust_ffi_allowlist := $(if $(strip $(RUST_FFI_ALLOWLIST)),$(abspath $(RUST_FFI_ALLOWLIST)),)
rust_ffi_source := $(srctree)/rust/ffi
rust_core_source := $(srctree)/rust/core
rust_drivers_source := $(srctree)/rust/drivers
rust_lib_source := $(srctree)/rust/lib
rust_workspace := $(srctree)/rust
rust_ffi_sources := $(wildcard $(rust_ffi_source)/src/*.rs)
rust_core_sources := $(wildcard $(rust_core_source)/src/*.rs)
rust_drivers_sources := $(wildcard $(rust_drivers_source)/src/*.rs)
rust_lib_sources := $(wildcard $(rust_lib_source)/src/*.rs)
rust_ffi_inputs := $(rust_workspace)/Cargo.toml $(rust_workspace)/Cargo.lock \
	$(rust_ffi_source)/Cargo.toml $(rust_ffi_source)/build.rs \
	$(rust_ffi_source)/headers.txt $(rust_ffi_sources) \
	$(rust_core_source)/Cargo.toml $(rust_core_source)/build.rs \
	$(rust_core_sources) $(rust_drivers_source)/Cargo.toml \
	$(rust_drivers_sources) $(rust_lib_source)/Cargo.toml \
	$(rust_lib_sources) $(rust_ffi_manifest) $(rust_ffi_allowlist)

ifeq ($(CONFIG_ARCH_RISCV32),y)
rust_ffi_target_default := riscv32imac-unknown-none-elf
rust_ffi_clang_target_default := riscv32-unknown-elf
else ifeq ($(CONFIG_ARCH_RISCV64),y)
rust_ffi_target_default := riscv64gc-unknown-none-elf
rust_ffi_clang_target_default := riscv64-unknown-elf
else ifeq ($(CONFIG_ARCH_ARM32),y)
rust_ffi_target_default := armv7a-none-eabi
rust_ffi_clang_target_default := arm-none-eabi
endif
rust_ffi_target := $(if $(strip $(RUST_FFI_TARGET)),$(RUST_FFI_TARGET),$(rust_ffi_target_default))
rust_ffi_clang_target := $(if $(strip $(RUST_FFI_CLANG_TARGET)),$(RUST_FFI_CLANG_TARGET),$(rust_ffi_clang_target_default))

ifeq ($(CONFIG_ARCH_RISCV64_ABI_LP64),y)
ifeq ($(CONFIG_RUST_FFI),y)
ifeq ($(strip $(RUST_FFI_TARGET)),)
$(error CONFIG_ARCH_RISCV64_ABI_LP64 requires RUST_FFI_TARGET with a matching LP64 Rust target)
endif
endif
endif

ifeq ($(CONFIG_EFEX),y)
rust_apps := $(rust-apps-efex-y)
else ifeq ($(CONFIG_APP_DRAM),y)
rust_apps := $(rust-apps-dram-y)
else
rust_apps := $(rust-apps-sram-y)
endif

rust_ffi_build_dir := $(objtree)/.obj/rust/$(board)/$(app_mode)
rust_core_lib := $(rust_ffi_build_dir)/$(rust_ffi_target)/release/libsyterkit_core.a
rust_app_build_root := $(objtree)/.obj/rust/$(board)/$(app_mode)/apps
rust_app_lib = $(rust_app_build_root)/$(1)/$(rust_ffi_target)/release/libsyterkit_core.a
rust_ffi_opt_level := $(if $(CONFIG_OPTIMIZE_FOR_SIZE),z,3)
rust_ffi_rustflags := -C panic=abort -C opt-level=$(rust_ffi_opt_level) \
	$(RUST_FFI_RUSTFLAGS)
rust_ffi_clang_args := --target=$(rust_ffi_clang_target) \
	$(KBUILD_CPPFLAGS) $(RUST_FFI_CLANG_ARGS)
rust_ffi_linker_flags :=
ifeq ($(CONFIG_RUST_FFI),y)
rust_ffi_linker_flags := $(RUST_FFI_LINKER_FLAGS)
ifeq ($(CONFIG_ARCH_ARM32),y)
ifeq ($(CONFIG_ARM_HARDFP),y)
# Stable Rust currently ships armv7a-none-eabi, not armv7a-none-eabihf.
# The Rust ABI is restricted to integer/pointer calls in this mode.
rust_ffi_linker_flags += -Wl,--no-warn-mismatch
endif
endif
endif

ifeq ($(CONFIG_RUST_FFI),y)
rust_core_link_input := $(rust_core_lib)

rust_app_missing_sources := $(foreach rust_app,$(rust_apps),\
	$(if $(wildcard $(srctree)/boards/$(board)/$(app_mode)/$(rust_app)/main.rs),,\
		$(error Rust app '$(rust_app)' is missing boards/$(board)/$(app_mode)/$(rust_app)/main.rs)))
rust_app_conflicts := $(filter $(rust_apps),$(apps))
ifneq ($(strip $(rust_app_conflicts)),)
$(error Rust app names also appear in the C app list: $(rust_app_conflicts))
endif
apps += $(rust_apps)

$(rust_core_lib): $(rust_ffi_inputs) $(KCONFIG_CONFIG) $(auto_conf) $(auto_header)
	@mkdir -p $(rust_ffi_build_dir)
	@echo "  CARGO   rust/core ($(rust_ffi_target))"
	@SYTERKIT_SOURCE_DIR="$(srctree)" \
	 SYTERKIT_FFI_HEADER_MANIFEST="$(rust_ffi_manifest)" \
	 SYTERKIT_FFI_HEADERS="$(RUST_FFI_HEADERS)" \
	 SYTERKIT_FFI_ALLOWLIST="$(rust_ffi_allowlist)" \
	 SYTERKIT_FFI_ARCH="$(arch_dir)" \
	 SYTERKIT_FFI_CLANG_ARGS="$(rust_ffi_clang_args)" \
	 SYTERKIT_FFI_CONFIG="$(KCONFIG_CONFIG)" \
	 SYTERKIT_FFI_AUTOCONF="$(auto_header)" \
	 CARGO_TARGET_DIR="$(rust_ffi_build_dir)" \
	 RUSTFLAGS="$(RUSTFLAGS) $(rust_ffi_rustflags)" \
	 $(RUST_FFI_CARGO) build --locked --release \
		--manifest-path $(rust_workspace)/Cargo.toml \
		--package syterkit-core \
		--target $(rust_ffi_target)

define rust_app_rule
rust_app_$(1)_source := $(srctree)/boards/$(board)/$(app_mode)/$(1)/main.rs
rust_app_$(1)_lib := $(call rust_app_lib,$(1))
rust_app_$(1)_c_source := $(srctree)/boards/$(board)/$(app_mode)/$(1)/main.c
rust_app_$(1)_builtin := $(if $(wildcard $(srctree)/boards/$(board)/$(app_mode)/$(1)/main.c),$(objtree)/.obj/apps/$(board)/$(app_mode)/$(1)/built-in.o,)

$$(rust_app_$(1)_lib): $(rust_ffi_inputs) $(KCONFIG_CONFIG) $(auto_conf) $(auto_header) $$(rust_app_$(1)_source) $$(rust_app_$(1)_c_source)
	@mkdir -p $$(dir $$@)
	@echo "  CARGO   boards/$(board)/$(app_mode)/$(1) ($(rust_ffi_target))"
	@SYTERKIT_SOURCE_DIR="$(srctree)" \
	 SYTERKIT_FFI_HEADER_MANIFEST="$(rust_ffi_manifest)" \
	 SYTERKIT_FFI_HEADERS="$(RUST_FFI_HEADERS)" \
	 SYTERKIT_FFI_ALLOWLIST="$(rust_ffi_allowlist)" \
	 SYTERKIT_FFI_ARCH="$(arch_dir)" \
	 SYTERKIT_FFI_CLANG_ARGS="$(rust_ffi_clang_args)" \
	 SYTERKIT_FFI_CONFIG="$(KCONFIG_CONFIG)" \
	 SYTERKIT_FFI_AUTOCONF="$(auto_header)" \
	 SYTERKIT_RUST_APP_SOURCE="$$(rust_app_$(1)_source)" \
	 CARGO_TARGET_DIR="$(rust_app_build_root)/$(1)" \
	 RUSTFLAGS="$(RUSTFLAGS) $(rust_ffi_rustflags)" \
	 $(RUST_FFI_CARGO) build --locked --release \
		--manifest-path $(rust_workspace)/Cargo.toml \
		--package syterkit-core \
		--target $(rust_ffi_target)
endef

$(foreach rust_app,$(rust_apps),$(eval $(call rust_app_rule,$(rust_app))))

rust_app_libs := $(foreach rust_app,$(rust_apps),$(call rust_app_lib,$(rust_app)))

.PHONY: rust-ffi
rust-ffi: $(rust_core_lib) $(rust_app_libs)
else
rust_apps :=
rust_core_link_input :=

.PHONY: rust-ffi
rust-ffi:
	@echo "Rust FFI is disabled; enable CONFIG_RUST_FFI in menuconfig first." >&2
	@false
endif

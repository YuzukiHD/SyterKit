menu "Architecture"

config ARCH_ARM
	bool

config ARCH_RISCV
	bool

choice
	prompt "Architecture"
	optional

config ARCH_ARM32
	select ARCH_ARM
	bool "ARM 32-bit"

config ARCH_RISCV32
	select ARCH_RISCV
	bool "RISC-V 32-bit"

config ARCH_RISCV64
	select ARCH_RISCV
	bool "RISC-V 64-bit"

endchoice

source "arch/arm/Kconfig"
source "arch/riscv/Kconfig"

config ARCH_DCACHE
	bool "Enable the data cache"

config ARCH_ICACHE
	bool "Enable the instruction cache"

config BACKTRACE
	bool

choice
	prompt "Backtrace implementation"
	optional

config BACKTRACE_MIN
	bool "Minimal address-only backtrace"
	select BACKTRACE
	help
	  Print raw return addresses with the smallest runtime and image-size
	  overhead.

config BACKTRACE_FULL
	bool "Full symbolized backtrace"
	select BACKTRACE
	help
	  Generate a symbol table for each output ELF and print function names,
	  offsets, and sizes in the call trace.

endchoice

config ARCH_EXCEPTION
	bool "Enable exception handling"
	depends on ARCH_ARM || ARCH_RISCV
	default y
	help
	  Keep the full exception handling flow: on ARM, the vector table with
	  per-mode (UND/ABT/IRQ/FIQ) exception stacks and individual handlers;
	  on RISC-V, the trap entry path with misaligned load/store emulation.
	  Disable to save SRAM.  When disabled, exceptions are not handled at
	  all: every trap falls into a no-stack halt loop (WFI on RISC-V,
	  WFI-equivalent halt on ARM) and the image never resumes.

source "arch/Kconfig.soc"

source "arch/Kconfig.boot"

endmenu

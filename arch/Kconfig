menu "Architecture"

choice
	prompt "Architecture"
	optional

config ARCH_ARM32
	bool "ARM 32-bit"

config ARCH_RISCV32
	bool "RISC-V 32-bit"

config ARCH_RISCV64
	bool "RISC-V 64-bit"

endchoice

source "arch/arm/Kconfig"
source "arch/riscv/Kconfig"

config ARCH_MINSTACK
	bool "Use the minimal startup stack"

config ARCH_DCACHE
	bool "Enable the data cache"

config BACKTRACE
	bool

choice
	prompt "Backtrace implementation"
	depends on ARCH_ARM32 || ARCH_RISCV32_CORE_E907 || ARCH_RISCV64_CORE_C906
	optional

config BACKTRACE_MIN
	bool "Minimal address-only backtrace"
	select BACKTRACE
	help
	  Print raw return addresses with the smallest runtime and image-size
	  overhead.

config BACKTRACE_FULL
	bool "Full symbolized backtrace"
	select BACKTRACE
	help
	  Generate a symbol table for each output ELF and print function names,
	  offsets, and sizes in the call trace.

endchoice

source "arch/Kconfig.soc"

endmenu

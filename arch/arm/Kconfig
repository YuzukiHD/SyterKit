choice
	prompt "ARM processor core"
	depends on ARCH_ARM32
	optional

config CPU_CORTEX_A7
	bool "Cortex-A7"

config CPU_ARMV8
	bool "ARMv8-A"

config CPU_ARMV8_2
	bool "ARMv8.2-A"

endchoice

config ARM_HARDFP
	bool "Use the hard-float ABI"
	depends on CPU_CORTEX_A7

config ARCH_MINSTACK
	bool "Disable exception-mode stacks"
	depends on ARCH_ARM32
	help
	  Omit the UND, ABT, IRQ and FIQ stacks to save SRAM. Exceptions use a
	  no-stack halt vector in this mode and cannot be handled or resumed.
